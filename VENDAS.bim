          {
            "name": "Meta Venda (Até Ontem)",
            "description": "Soma do valor da meta de venda acumulada estritamente até o dia de ontem.",
            "expression": [
              "CALCULATE(",
              "    SUM('Metas (Dia)'[META_CATEGORIA_VALOR_VENDA]),",
              "    'Calendário'[Flag Data Passada] = 1",
              ")"
            ],
            "formatString": "R$ #,##0;(R$ #,##0); -",
