          {
            "name": "Realizado x Meta",
            "description": "Medida mestre com formatação dinâmica ativada por métrica.",
            "expression": [
              "VAR _GrupoSelecao = SELECTEDVALUE('Menu Grupo'[Grupo Macro])",
              "VAR _MetricaSelecao = SELECTEDVALUE('Menu Métrica'[Métrica Fatiador])",
              "",
              "RETURN",
              "    SWITCH(TRUE(),",
              "        _GrupoSelecao = \"Venda\" && _MetricaSelecao = \"Valor\", [Real x Meta],",
              "        _GrupoSelecao = \"Venda\" && _MetricaSelecao = \"Margem Comercial (%)\", [Real Ajustado X Meta],",
              "        _GrupoSelecao = \"Venda\" && _MetricaSelecao = \"Margem de Contribuição (%)\", [Real contr. Ajustada x Meta],",
              "        BLANK()",
              "    )"
            ],
            "formatString": "+0.00%;(0.00%);0.00%",
            "displayFolder": "Menu Cascata Inteligente",
            "lineageTag": "e2013fc9-dc69-4cba-b60d-d2fb224b6410"
          },
          {
            "name": "Faturamento Líquido Mês Anterior",
            "description": "Retorna o valor de Faturamento Líquido para o mesmo período do mês anterior, limitado estritamente até o dia de hoje.",
            "expression": [
              "IF(",
              "    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,",
              "    CALCULATE(",
              "        [Faturamento Líquido],",
              "        DATEADD('Calendário'[Dia], -1, MONTH)",
              "    )",
              ")"
            ],
            "formatString": "R$ #,##0;(R$ #,##0); -",
            "displayFolder": "Vendas Diárias\\Comparativos Curto Prazo\\Mês Anterior",
            "lineageTag": "fdd4d98a-dbfc-4167-ac89-f4a15a875cc6"
          },
          {
            "name": "Faturamento Líquido Var R$ MoM",
            "description": "Diferença absoluta entre o Faturamento Líquido atual e o do mês anterior (MoM).",
            "expression": "[Faturamento Líquido] - [Faturamento Líquido Mês Anterior]",
            "formatString": "R$ #,##0;(R$ #,##0); -",
            "displayFolder": "Vendas Diárias\\Comparativos Curto Prazo\\Mês Anterior",
            "lineageTag": "82ecc04f-8d9a-4524-b821-815358cac3c5"
          },
          {
            "name": "Faturamento Líquido Var % MoM",
            "description": "Variação percentual do Faturamento Líquido em relação ao mês anterior (MoM).",
            "expression": [
              "DIVIDE(",
              "    [Faturamento Líquido] - [Faturamento Líquido Mês Anterior],",
              "    [Faturamento Líquido Mês Anterior]",
              ")"
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Comparativos Curto Prazo\\Mês Anterior",
            "lineageTag": "24cd0c38-eb9d-49a6-a472-17cea2a7c132"
          },
          {
            "name": "Margem Comercial Ajustada Mês Anterior",
            "description": "Retorna o valor de Margem Comercial Ajustada para o mesmo período do mês anterior, limitado estritamente até o dia de hoje.",
            "expression": [
              "IF(",
              "    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,",
              "    CALCULATE(",
              "        [Margem Comercial Ajustada],",
              "        DATEADD('Calendário'[Dia], -1, MONTH)",
              "    )",
              ")"
            ],
            "formatString": "R$ #,##0;(R$ #,##0);R$ 0",
            "displayFolder": "Vendas Diárias\\Comparativos Curto Prazo\\Mês Anterior",
            "lineageTag": "92d00eac-1a15-42f2-b566-d23a747a8ecb"
          },
          {
            "name": "Margem Comercial Ajustada Var % MoM",
            "description": "Variação percentual da Margem Comercial Ajustada em relação ao mês anterior (MoM).",
            "expression": [
              "DIVIDE(",
              "    [Margem Comercial Ajustada] - [Margem Comercial Ajustada Mês Anterior],",
              "    [Margem Comercial Ajustada Mês Anterior]",
              ")"
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Comparativos Curto Prazo\\Mês Anterior",
            "lineageTag": "ccc3fc15-1a51-4ea0-b19e-5161a66ed38e"
          },
          {
            "name": "Faturamento Líquido Semana Anterior",
            "description": "Retorna o valor de Faturamento Líquido para os mesmos dias da semana anterior (deslocamento de 7 dias), limitado estritamente até o dia de hoje.",
            "expression": [
              "IF(",
              "    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,",
              "    CALCULATE(",
              "        [Faturamento Líquido],",
              "        DATEADD('Calendário'[Dia], -7, DAY)",
              "    )",
              ")"
            ],
            "formatString": "R$ #,##0;(R$ #,##0); -",
            "displayFolder": "Vendas Diárias\\Comparativos Curto Prazo\\Semana Anterior",
            "lineageTag": "032ebdf7-1944-49ca-b6e2-0a69872a586c"
          },
          {
            "name": "Faturamento Líquido Var % WoW",
            "description": "Variação percentual do Faturamento Líquido em relação à semana anterior (WoW, deslocamento de 7 dias).",
            "expression": [
              "DIVIDE(",
              "    [Faturamento Líquido] - [Faturamento Líquido Semana Anterior],",
              "    [Faturamento Líquido Semana Anterior]",
              ")"
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Comparativos Curto Prazo\\Semana Anterior",
            "lineageTag": "8690ae82-0228-434e-9846-2d1c753f9dec"
          },
          {
            "name": "Cor Mes",
            "description": "Retorna um código de cor hexadecimal para formatação condicional de visuais por mês (cores alternadas par/impar).",
            "expression": [
              "VAR NumeroMes =",
              "    MONTH(MAX('Calendário'[Dia]))",
              "",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISINSCOPE('Calendário'[Mês]) && MOD(NumeroMes, 2) = 0, \"#FFF4B3\",",
              "        ISINSCOPE('Calendário'[Mês]) && MOD(NumeroMes, 2) <> 0, \"#D9F7D9\",",
              "        \"#FFFFFF\"",
              "    )"
            ],
            "isHidden": true,
            "lineageTag": "933867ca-5797-44a3-aadb-fe376e7dd091"
          },
          {
            "name": "Titulo_Painel_Mestre",
            "description": "Título dinâmico geral para o cabeçalho do painel.",
            "expression": [
              "VAR _Grupo = SELECTEDVALUE('Menu Grupo'[Grupo Macro], \"Geral\")",
              "VAR _Metrica = SELECTEDVALUE('Menu Métrica'[Métrica Fatiador], \"Indicadores\")",
              "RETURN",
              "    UPPER(\"Análise de \" & _Grupo & \" - \" & _Metrica)"
            ],
            "formatString": "General",
            "displayFolder": "Menu Cascata Inteligente",
            "lineageTag": "2749317c-5f49-4f80-be08-b1d2986a586f"
          },
          {
            "name": "Desempenho_Grafico",
            "description": "Medida com escala logarítmica baseada no Realizado para suavizar a proporção visual das barras de dados.",
            "expression": "IF([Realizado] > 0, LOG([Realizado]), 0)",
            "formatString": "0.00",
            "displayFolder": "Menu Cascata Inteligente",
            "lineageTag": "585848bf-5ed7-4c16-aac1-7dd7767e10ce"
          },
          {
            "name": "Participacao_Filial",
            "description": "Métrica de participação percentual da filial sobre o total filtrado na tela.",
            "expression": [
              "VAR ValorLinha = [Realizado]",
              "VAR TotalGeralFilial = CALCULATE([Realizado], ALLSELECTED('Lojas'[Filial]))",
              "RETURN",
              "    DIVIDE(ValorLinha, TotalGeralFilial)"
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Menu Cascata Inteligente",
            "lineageTag": "7059963c-9053-4482-950a-a8be9189f1ac"
          },
          {
            "name": "Participacao_Fornecedor",
            "description": "Métrica de participação percentual do fornecedor sobre o total filtrado na tela.",
            "expression": [
              "VAR ValorLinha = [Realizado]",
              "VAR TotalGeralForn = CALCULATE([Realizado], ALLSELECTED('Produto'[Fornecedor Master]))",
              "RETURN",
              "    DIVIDE(ValorLinha, TotalGeralForn)"
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Menu Cascata Inteligente",
            "lineageTag": "76870e14-2ec1-4039-a007-7694f20ce685"
          },
          {
            "name": "Var % MGC%",
            "description": "Calcula a variação percentual da Margem Comercial Ajustada do período atual em relação ao Ano Anterior.",
            "expression": "DIVIDE([MG (%) Ajustado], [MG (%) Ano-1 Ajustado]) - 1",
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Margem Comercial\\Variações",
            "lineageTag": "4690887f-e6c8-4ffc-a1ae-2336931e24f0"
          },
          {
            "name": "Var % MG Contribuicao%",
            "description": "Calcula a variação percentual da Margem de Contribuição Ajustada do período atual em relação ao Ano Anterior.",
            "expression": "DIVIDE([MG(%) contr. Ajustada], [MG(%) Ano-1 contr. Ajustada]) - 1",
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Margem de Contribuição\\Variações",
            "lineageTag": "d104fae1-f0a2-497b-a5bd-7d41f681a474"
          },
          {
            "name": "Realizado_Barra",
            "description": "Medida pura de Realizado duplicada para uso exclusivo em Barras de Dados sem distorção logarítmica.",
            "expression": [
              "/* Medida criada exclusivamente para renderização de Barras de Dados */",
              "VAR _GrupoSelecao = SELECTEDVALUE('Menu Grupo'[Grupo Macro])",
              "VAR _MetricaSelecao = SELECTEDVALUE('Menu Métrica'[Métrica Fatiador])",
              "",
              "RETURN",
              "    SWITCH(TRUE(),",
              "        _GrupoSelecao = \"Venda\" && _MetricaSelecao = \"Valor\", [Faturamento Líquido],",
              "        _GrupoSelecao = \"Venda\" && _MetricaSelecao = \"Quantidade\", [Quantidade Líquida Vendida],",
              "        _GrupoSelecao = \"Venda\" && _MetricaSelecao = \"Tonelagem\", [Tonelagem Líquida Vendida],",
              "        _GrupoSelecao = \"Venda\" && _MetricaSelecao = \"Margem Comercial (Valor)\", [Margem Comercial],",
              "        _GrupoSelecao = \"Venda\" && _MetricaSelecao = \"Margem Comercial (%)\", [MG (%) Ajustado],",
              "        _GrupoSelecao = \"Venda\" && _MetricaSelecao = \"Margem de Contribuição (Valor)\", [Margem Contribuição],",
              "        _GrupoSelecao = \"Venda\" && _MetricaSelecao = \"Margem de Contribuição (%)\", [MG(%) contr. Ajustada],",
              "        _GrupoSelecao = \"Acordos\" && _MetricaSelecao = \"Valor\", [Valor Verba],",
              "        _GrupoSelecao = \"Ticket\" && _MetricaSelecao = \"Quantidade\", [Qtd Tickets Hora Filial],",
              "        _GrupoSelecao = \"Ticket\" && _MetricaSelecao = \"Penetração\", [Part % Tickets Hora Filial],",
              "        _GrupoSelecao = \"Cliente\" && _MetricaSelecao = \"Quantidade\", [Qtd Clientes Hora Filial],",
              "        _GrupoSelecao = \"Cliente\" && _MetricaSelecao = \"Penetração\", [Part % Clientes Hora Filial],",
              "        _GrupoSelecao = \"Compra\" && _MetricaSelecao = \"Valor\", [Valor Agenda de Compra],",
              "        _GrupoSelecao = \"Compra\" && _MetricaSelecao = \"Quantidade\", [Qtd Agenda de Compra],",
              "        _GrupoSelecao = \"Compra\" && _MetricaSelecao = \"Tonelagem\", [Tonelagem Agenda de Compra],",
              "        _GrupoSelecao = \"Perda\" && _MetricaSelecao = \"Valor\", [Valor Total Perda],",
              "        _GrupoSelecao = \"Perda\" && _MetricaSelecao = \"Quantidade\", [Quantidade Perda],",
              "        BLANK()",
              "    )"
            ],
            "displayFolder": "Menu Cascata Inteligente",
            "lineageTag": "1bf926fc-ef66-46a1-b13c-edaaa9a34b41",
            "formatStringDefinition": {
              "expression": [
                "VAR _M = SELECTEDVALUE('Menu Métrica'[Métrica Fatiador]) ",
                "RETURN ",
                "    SWITCH(",
                "        TRUE(),",
                "        _M = \"Penetração\" || CONTAINSSTRING(_M, \"%\"), \"0.0%\",",
                "        _M = \"Quantidade\" || _M = \"Tickets\" || _M = \"Clientes\", \"#,##0\",",
                "        _M = \"Tonelagem\", \"#,##0.00\",",
                "        \"R$ #,##0.00\" -- Padrão para Valor ou qualquer outra métrica monetária",
                "    )"
              ]
            }
          },
          {
            "name": "Cor_Condicional_Dax",
            "description": "Medida dinâmica para formatação condicional de cores (Vermelho se < 0, Verde se >= 0).",
            "expression": [
              "VAR _Valor = [Var %]",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    ISBLANK(_Valor), \"#000000\",",
              "    _Valor < 0, \"#FF0000\",   -- Vermelho para negativos",
              "    _Valor >= 0, \"#008000\",  -- Verde para positivos",
              "    \"#000000\"",
              ")"
            ],
            "formatString": "@",
            "isHidden": true,
            "lineageTag": "e66694c2-1eff-4eb7-93f9-5c49f5c4fc34"
          },
          {
            "name": "Faturamento Líquido copy",
            "description": "ALTERADO MANUALMENTE - TESTE LOCAL",
            "expression": "SUM('Vendas (Dia)'[VLR_VENDA_TOTAL_C_IMP]) - SUM('Vendas (Dia)'[VLR_DEVOLUCAO_TOTAL_C_IMP])",
            "formatString": "R$ #,##0;(R$ #,##0); -",
            "displayFolder": "Vendas Diárias\\Faturamento",
            "lineageTag": "cfc4e96e-0fb8-440d-b690-35e584cd9453"
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "ececf2b2e77b44ffa94eff7960790f87"
          }
        ]
