/// Tabela de medidas centralizada
table Medidas
	lineageTag: 91191ee1-9a46-4963-973d-057009375897

	/// Valor total acumulado de verbas e acordos comerciais negociados.
	measure 'Valor Verba' = SUM('Verbas e Acordos (Dia)'[VALOR_VERBA])
		formatString: R$ #,##0;-R$ #,##0;"-"
		displayFolder: Verbas e Acordos
		lineageTag: a7803bb5-61bc-45f7-b092-981f4788b37f

	/// Valor total acumulado referente ao custo apurado dos produtos.
	measure 'Valor Custo Apurado' = SUM('Ajustes de Custo (Dia)'[VLR_CUSTO_APURADO])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Ajuste de Custo
		lineageTag: 17465112-511a-4ff0-8987-223bc1e23376

	/// Valor total acumulado de ajustes gerenciais gerais.
	measure 'Valor Ajuste Gerencial' = SUM('Ajustes Gerenciais (Dia)'[VALOR_AJUSTE_GERENCIAL])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Ajustes Gerenciais
		lineageTag: 3965a01d-86e0-4f13-b337-769e2d4084c5

	/// Valor total de ajustes gerenciais aplicados especificamente à margem de contribuição.
	measure 'Valor Ajuste Margem Contribuição' = SUM('Ajustes Gerenciais (Dia)'[VALOR_AJUSTE_GERENCIAL_MARGEM_CONTRIBUICAO])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Ajustes Gerenciais
		lineageTag: 32c30f57-3207-458a-987d-019781ad6392

	/// Valor total de ajustes gerenciais aplicados à margem do Ponto de Venda (PDV).
	measure 'Valor Ajuste Margem PDV' = SUM('Ajustes Gerenciais (Dia)'[VALOR_AJUSTE_GERENCIAL_MARGEM_PDV])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Ajustes Gerenciais
		lineageTag: fffd9479-fdf2-4174-aa48-ce19e7abb642

	/// Valor total de ajustes gerenciais associados a perdas.
	measure 'Valor Ajuste Perda Gerencial' = SUM('Ajustes Gerenciais (Dia)'[VALOR_AJUSTE_GERENCIAL_PERDA])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Ajustes Gerenciais
		lineageTag: d2299784-591e-4072-802d-ea504f9e34f8

	/// Soma do valor da meta de venda acumulada estritamente até o dia de ontem.
	measure 'Meta Venda (Até Ontem)' =
			CALCULATE(
			    SUM('Metas (Dia)'[META_CATEGORIA_VALOR_VENDA]),
			    'Calendário'[Flag Data Passada] = 1
			)
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Metas\Metas Financeiras
		lineageTag: 16f9a34e-0a82-4fd3-ba70-c140a73a7e1b

	/// Soma do valor da meta de perda acumulada estritamente até o dia de ontem.
	measure 'Meta Perda (Até Ontem)' =
			CALCULATE(
			    SUM('Metas (Dia)'[META_CATEGORIA_VALOR_PERDA]),
			    'Calendário'[Flag Data Passada] = 1
			)
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Metas\Metas Financeiras
		lineageTag: 959e284a-10ab-4f63-8ffc-4c0b54dfc12a

	/// Soma do valor da meta de embalagem acumulada estritamente até o dia de ontem.
	measure 'Meta Embalagem (Até Ontem)' = CALCULATE( SUM('Metas (Dia)'[META_CATEGORIA_VALOR_EMBALAGEM]), KEEPFILTERS('Calendário'[Flag Data Passada] = 1) )
		formatString: #,##0;-#,##0;0
		displayFolder: Metas\Metas de Volume
		lineageTag: 3b95f25f-e4f3-4e08-be3f-4106ce16b26e

	/// Soma do valor da meta de margem comercial acumulada estritamente até o dia de ontem.
	measure 'Margem Comercial Meta (Até Ontem)' =
			CALCULATE(
			    SUM('Metas (Dia)'[META_CATEGORIA_VALOR_MARGEM_COMERCIAL]),
			    'Calendário'[Flag Data Passada] = 1
			)
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Metas\Metas Financeiras
		lineageTag: c90bc9f2-22ae-4779-88b2-73802624f42e

	/// Soma do valor da meta de margem de contribuição acumulada estritamente até o dia de ontem.
	measure 'Margem Contribuição Meta (Até Ontem)' =
			CALCULATE(
			    SUM('Metas (Dia)'[META_CATEGORIA_VALOR_MARGEM_CONTRIBUICAO]),
			    'Calendário'[Flag Data Passada] = 1
			)
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Metas\Metas Financeiras
		lineageTag: ef70e01a-6e85-41e1-b7e3-259271ccf5a7

	/// Meta total estipulada em volume/tonelagem.
	measure 'Meta Categoria - Qtd Tonelagem (Até Ontem)' = CALCULATE( SUM('Metas (Dia)'[META_CATEGORIA_QTD_TONELAGEM]), KEEPFILTERS('Calendário'[Flag Data Passada] = 1) )
		formatString: #,##0.00;-#,##0.00;0.00
		displayFolder: Metas\Metas de Volume
		lineageTag: 976cbb36-08af-4a41-9571-71f909182be3

	/// Valor total acumulado referente aos custos ou participações de embalagens.
	measure 'Valor Embalagem' = SUM('Participação de Embalagens (Dia)'[VALOR_EMBALAGEM])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Participação de Embalagem
		lineageTag: acf00292-b3e8-436f-af6f-683a7519670d

	/// Quantidade física total de produtos perdidos ou quebrados.
	measure 'Quantidade Perda' = SUM('Perdas de Produtos (Dia)'[QTD_PERDA])
		formatString: #,##0;-#,##0;0
		displayFolder: Perdas por Produto
		lineageTag: 92f1ae80-dda9-4516-8bf5-c8018084d30f

	/// Custo/valor total financeiro acumulado com as perdas de produtos.
	measure 'Valor Total Perda' = SUM('Perdas de Produtos (Dia)'[VALOR_TOTAL_PERDA])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Perdas por Produto
		lineageTag: f6541200-62f2-4925-b144-f5abb1ccbb90

	/// Quantidade bruta de vendas faturadas no período. ATENÇÃO: Este indicador NÃO desconta as devoluções de mercadorias.
	measure 'Quantidade Vendida' = SUM('Vendas (Dia)'[QTD_VENDA])
		formatString: #,##0;-#,##0;0
		displayFolder: Vendas Diárias\Volume
		lineageTag: 25dab783-8164-4a94-861d-f0d9cfc2fb5c

	/// Quantidade líquida faturada (Quantidade Vendida menos a Quantidade Devolvida). Use este indicador para análises reais de volume entregue.
	measure 'Quantidade Líquida Vendida' = SUM('Vendas (Dia)'[QTD_VENDA]) - SUM('Vendas (Dia)'[QTD_DEVOLUCAO])
		formatString: #,##0;-#,##0;0
		displayFolder: Vendas Diárias\Volume
		lineageTag: e8719d3b-d474-4a77-b8b4-207661564d8b

	/// Quantidade total de itens devolvidos no período.
	measure 'Quantidade Devolvida' = SUM('Vendas (Dia)'[QTD_DEVOLUCAO])
		formatString: #,##0;-#,##0;0
		displayFolder: Vendas Diárias\Volume
		lineageTag: 46c21e4b-78e5-47ec-8ac2-d7c51ac6d8c0

	/// Peso total bruto das mercadorias vendidas em toneladas. Não deduz devoluções.
	measure 'Tonelagem Vendida' = SUM('Vendas (Dia)'[QTD_TONELAGEM_VENDA])
		formatString: #,##0.00;-#,##0.00;0.00
		displayFolder: Vendas Diárias\Volume
		lineageTag: 0ad54039-7d45-4782-8d37-21b2a6a62449

	/// Peso total das mercadorias devolvidas em toneladas.
	measure 'Tonelagem Devolvida' = SUM('Vendas (Dia)'[QTD_TONELAGEM_DEVOLUCAO])
		formatString: #,##0.00;-#,##0.00;0.00
		displayFolder: Vendas Diárias\Volume
		lineageTag: e53a7347-b8e7-4d7c-864a-263fe381c01a

	/// Peso líquido real das mercadorias entregues (Tonelagem Vendida menos Tonelagem Devolvida).
	measure 'Tonelagem Líquida Vendida' = SUM('Vendas (Dia)'[QTD_TONELAGEM_VENDA]) - SUM('Vendas (Dia)'[QTD_TONELAGEM_DEVOLUCAO])
		formatString: #,##0.00;-#,##0.00;0.00
		displayFolder: Vendas Diárias\Volume
		lineageTag: 0efe9a85-f131-4874-9fc3-88703bfce953

	/// Valor total bruto faturado com impostos. Não desconta devoluções.
	measure 'Faturamento Bruto' = SUM('Vendas (Dia)'[VLR_VENDA_TOTAL_C_IMP])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Faturamento
		lineageTag: 89ed238e-4f29-44d8-a161-b809a49d8540

	/// Valor total bruto das devoluções de vendas ocorridas no período (com impostos).
	measure 'Valor Devolvido' = SUM('Vendas (Dia)'[VLR_DEVOLUCAO_TOTAL_C_IMP])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Faturamento
		lineageTag: 722bc797-d8f0-4ab3-8434-68351eeea94a

	/// Faturamento real da empresa (Faturamento Bruto menos Valor Devolvido).
	measure 'Faturamento Líquido' = SUM('Vendas (Dia)'[VLR_VENDA_TOTAL_C_IMP]) - SUM('Vendas (Dia)'[VLR_DEVOLUCAO_TOTAL_C_IMP])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Faturamento
		lineageTag: 1a7ffa9f-5003-4402-a735-af8dd4224db7

	/// Valor total do custo das mercadorias vendidas. Não abate o custo das devoluções.
	measure 'Custo Bruto' = SUM('Vendas (Dia)'[VLR_CUSTO_TOTAL_VENDA])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Custos
		lineageTag: 1393d0d5-49d1-4b80-86da-12412dd94c0f

	/// Valor total do custo que retornou ao estoque através de devoluções no período.
	measure 'Custo Devolvido' = SUM('Vendas (Dia)'[VLR_CUSTO_TOTAL_DEVOLUCAO])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Custos
		lineageTag: 2aaa63d2-7378-4637-897b-e350ec1df77b

	/// Custo real da operação comercial (Custo Bruto menos Custo Devolvido).
	measure 'Custo Líquido' = SUM('Vendas (Dia)'[VLR_CUSTO_TOTAL_VENDA]) - SUM('Vendas (Dia)'[VLR_CUSTO_TOTAL_DEVOLUCAO])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Custos
		lineageTag: 78aa833a-5077-4e06-9aa3-d60678d105a8

	/// Valor total de ICMS destacado sobre as vendas brutas.
	measure 'ICMS Bruto' = SUM('Vendas (Dia)'[VLR_ICMS_VENDA])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Impostos
		lineageTag: 81fe1ca1-71ac-410d-83fb-30363f0d4d2b

	/// Valor de crédito de ICMS recuperado através de devoluções.
	measure 'ICMS Devolvido' = SUM('Vendas (Dia)'[VLR_ICMS_DEVOLUCAO])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Impostos
		lineageTag: 3cd6a111-d0a6-4e09-9221-40a6763f8206

	/// ICMS real devido (ICMS Bruto menos ICMS Devolvido).
	measure 'ICMS Líquido' = SUM('Vendas (Dia)'[VLR_ICMS_VENDA]) - SUM('Vendas (Dia)'[VLR_ICMS_DEVOLUCAO])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Impostos
		lineageTag: bbee4c85-7b6e-4632-8966-de4087a1de54

	/// Valor total de PIS/COFINS incidente sobre o faturamento bruto.
	measure 'PIS COFINS Bruto' = SUM('Vendas (Dia)'[VLR_PIS_COFINS_VENDA])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Impostos
		lineageTag: 1c7ce6c2-bd1a-4ffa-9382-28cc7e53811f

	/// Crédito de PIS/COFINS estornado por motivo de devolução.
	measure 'PIS COFINS Devolvido' = SUM('Vendas (Dia)'[VLR_PIS_COFINS_DEVOLUCAO])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Impostos
		lineageTag: 649dd230-2ff1-4e60-84ed-5f62b3fa1253

	/// PIS/COFINS líquido gerado na operação comercial.
	measure 'PIS COFINS Líquido' = SUM('Vendas (Dia)'[VLR_PIS_COFINS_VENDA]) - SUM('Vendas (Dia)'[VLR_PIS_COFINS_DEVOLUCAO])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Impostos
		lineageTag: 62440e71-2e40-4dc9-9f57-2f7c0c937492

	/// Quantidade total de itens/produtos vendidos por hora.
	measure 'Quantidade Venda Hora' = SUM('Vendas por Hora'[QTD_VENDA_HORA])
		formatString: #,##0;-#,##0;0
		displayFolder: Vendas por Hora
		lineageTag: 429bd901-879b-40b8-b463-5dad5f1dd4d8

	/// Valor total de descontos aplicados nas vendas por hora.
	measure 'Valor Desconto Venda Hora' = SUM('Vendas por Hora'[VLR_DESCONTO])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas por Hora
		lineageTag: 86ada5ed-a80b-4fa5-86b0-9a4f9af8eb52

	/// Valor total bruto das vendas registradas por hora.
	measure 'Valor Venda Hora' = SUM('Vendas por Hora'[VLR_VENDA_HORA])
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas por Hora
		lineageTag: f7dc50d1-af9c-42a9-a5ee-d09d89f71a1c

	/// Quantidade total de embalagens movimentadas nas agendas.
	measure 'Qtd Embalagens' = SUM('Agendamentos (Dia)'[QTD_EMBALAGEM])
		formatString: #,##0;-#,##0;0
		displayFolder: Movimento de Agendas\Métricas de Volume
		lineageTag: 2b694f91-4b7a-4fe5-ade6-673d29366358

	/// Quantidade total de notas fiscais emitidas.
	measure 'Qtd Notas' = SUM('Agendamentos (Dia)'[QTD_NOTA])
		formatString: #,##0;-#,##0;0
		displayFolder: Movimento de Agendas\Métricas de Volume
		lineageTag: 7989aecf-31f1-4533-a6cf-e3ceca3d18d3

	/// Quantidade de embalagens registradas pelo fornecedor.
	measure 'Qtd Embalagens Fornecedor' = SUM('Agendamentos (Dia)'[QTD_EMBALAGEM_FORNECEDOR])
		formatString: #,##0;-#,##0;0
		displayFolder: Movimento de Agendas\Métricas de Volume
		lineageTag: bf44d869-bdde-4c7d-bae2-27fbacd29636

	/// Peso líquido total processado no dia em quilogramas.
	measure 'Peso Líquido Dia (Kg)' = SUM('Agendamentos (Dia)'[QTD_PESO_LIQUIDO_DIA])
		formatString: #,##0;-#,##0;0
		displayFolder: Movimento de Agendas\Métricas de Volume
		lineageTag: 0c0cad45-35d2-43cd-a927-e4d3f17c592f

	/// Peso líquido total acumulado em quilogramas.
	measure 'Peso Líquido Total (Kg)' = SUM('Agendamentos (Dia)'[QTD_PESO_LIQUIDO])
		formatString: #,##0;-#,##0;0
		displayFolder: Movimento de Agendas\Métricas de Volume
		lineageTag: f36e917f-1d0d-4cea-b882-4a3c043d922b

	/// Valor total bruto das agendas registradas.
	measure Total = SUM('Agendamentos (Dia)'[VLR_TOTAL])
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Movimento de Agendas\Métricas Financeiras
		lineageTag: 9582c0bf-1fbe-48f1-8dc3-0052628645f9

	/// Valor total de ICMS creditado/debitado.
	measure ICMS = SUM('Agendamentos (Dia)'[VLR_ICMS])
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Movimento de Agendas\Métricas Financeiras
		lineageTag: 4bc7abbd-6cec-4ad6-8404-082501520c9a

	/// Valor total de contribuição de PIS e COFINS.
	measure PIS/COFINS = SUM('Agendamentos (Dia)'[VLR_PIS_COFINS])
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Movimento de Agendas\Métricas Financeiras
		lineageTag: 06603c5e-6cd6-4c5a-82ad-666f420c4dae

	/// Valor total da base de cálculo utilizada para o ICMS.
	measure 'Base Cálculo ICMS' = SUM('Agendamentos (Dia)'[VLR_BASE_CALC_ICMS])
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Movimento de Agendas\Métricas Financeiras
		lineageTag: 47a836bc-201f-4b39-8d8d-3cd8ecba97d2

	/// Valor total de IPI gerado.
	measure IPI = SUM('Agendamentos (Dia)'[VLR_IPI])
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Movimento de Agendas\Métricas Financeiras
		lineageTag: a1ed435e-2ebb-462d-b998-194c37c521cc

	/// Valor total de Substituição Tributária (ST).
	measure ST = SUM('Agendamentos (Dia)'[VLR_ST])
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Movimento de Agendas\Métricas Financeiras
		lineageTag: fa799e6d-512b-4edc-b9d0-dce61966868b

	/// Valor total acumulado do custo unitário dos itens acordados.
	measure 'Custo Unitário Médio' = SUM('Agendamentos (Dia)'[VLR_CUSTO_UNITARIO])
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Movimento de Agendas\Métricas Financeiras
		lineageTag: b1c45f40-167a-4fb6-9525-a49c0a32308a

	/// Valor total acumulado do preço unitário de venda/transferência.
	measure 'Preço Unitário Médio' = SUM('Agendamentos (Dia)'[VLR_PRECO_UNITARIO])
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Movimento de Agendas\Métricas Financeiras
		lineageTag: 13cc016d-f248-4dd7-830a-5b6f60b6cd11

	/// Valor acumulado da alíquota de ICMS registrado nas agendas (armazenado em valor inteiro/nominal na origem, ex: 39.00).
	measure 'Alíquota ICMS' = SUM('Agendamentos (Dia)'[PERC_ICMS])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Movimento de Agendas\Métricas de Apoio
		lineageTag: 9b39a328-a692-463f-87d5-6fef8d26d0ff

	/// Valor acumulado da alíquota de PIS/COFINS registrado nas agendas (armazenado em valor inteiro/nominal na origem)
	measure 'Alíquota PIS/COFINS' = SUM('Agendamentos (Dia)'[PERC_PIS_COFINS])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Movimento de Agendas\Métricas de Apoio
		lineageTag: fb0a9521-eb73-401a-9a3e-08dc157112cb

	/// Retorna o valor de Valor Verba para o mesmo período do ano anterior, limitado estritamente até o dia de hoje.
	measure 'Valor Verba Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Valor Verba],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: R$ #,##0;-R$ #,##0;"-"
		displayFolder: Verbas e Acordos\Ano Anterior
		lineageTag: ada4cf05-1299-4fda-b3af-c61741fe8498

	/// Retorna o valor de Valor Custo Apurado para o mesmo período do ano anterior, limitado estritamente até o dia de hoje.
	measure 'Valor Custo Apurado Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Valor Custo Apurado],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Ajuste de Custo\Ano Anterior
		lineageTag: 98d30290-753f-404b-9fc4-56ef59bd80d3

	/// Retorna o valor de Valor Ajuste Gerencial para o mesmo período do ano anterior, limitado estritamente até o dia de hoje.
	measure 'Valor Ajuste Gerencial Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Valor Ajuste Gerencial],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Ajustes Gerenciais\Ano Anterior
		lineageTag: aabf0e82-cb8c-4caa-8b61-190b70c2a47b

	/// Retorna o valor de Valor Ajuste Margem Contribuição para o mesmo período do ano anterior, limitado estritamente até o dia de hoje.
	measure 'Valor Ajuste Margem Contribuição Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Valor Ajuste Margem Contribuição],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Ajustes Gerenciais\Ano Anterior
		lineageTag: c465686f-f27d-4a2b-8199-fa01ffe5608a

	/// Retorna o valor de Valor Ajuste Margem PDV para o mesmo período do ano anterior, limitado estritamente até o dia de hoje.
	measure 'Valor Ajuste Margem PDV Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Valor Ajuste Margem PDV],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: R$ #,##0;-R$ #,##0; -
