            "description": "Variação percentual de tickets emitidos em relação ao ano anterior.",
            "expression": "DIVIDE([Qtd Tickets Hora Filial Var Abs], [Qtd Tickets Hora Filial Ano Anterior])",
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas por Hora\\Atendimento\\Variações",
            "lineageTag": "779776b2-16cc-4b52-bc6d-b6f3a3a9ef8f"
          },
          {
            "name": "Vlr Sobra/falta",
            "description": "Medida de acompanhamento da Matriz do Relatório Executivo.",
            "expression": "[Faturamento Líquido] - [Meta Venda (Até Ontem)]",
            "formatString": "R$ #,##0;(R$ #,##0); -",
            "displayFolder": "Vendas Diárias\\Faturamento",
            "lineageTag": "94d34d79-0697-4694-95a8-f19ba5070725"
          },
          {
            "name": "Sobra/Falta - dias",
            "description": "Medida de acompanhamento da Matriz do Relatório Executivo.",
            "expression": "DIVIDE([Vlr Sobra/falta], [Venda Média Dia], 0)",
            "formatString": "#,##0.00;(#,##0.00);0.00",
            "displayFolder": "Vendas Diárias\\Faturamento",
            "lineageTag": "eaa8bcc1-5b68-42dd-8b1b-31b358371dfc"
          },
          {
            "name": "Real x Meta",
            "description": "Medida de acompanhamento da Matriz do Relatório Executivo.",
            "expression": "DIVIDE([Faturamento Líquido] - [Meta Venda (Até Ontem)], [Meta Venda (Até Ontem)], 0)",
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Faturamento\\Variações",
            "lineageTag": "a45224c0-ec74-4f88-922c-2a0d5e573921"
          },
          {
            "name": "Ano-1 (%)",
            "description": "Medida de acompanhamento da Matriz do Relatório Executivo.",
            "expression": "DIVIDE([Faturamento Líquido] - [Faturamento Líquido Ano Anterior], [Faturamento Líquido Ano Anterior], 0)",
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Faturamento\\Variações",
            "lineageTag": "33e08583-be8b-43a0-bc83-14f36d01d019"
          },
          {
            "name": "Real x Ano-1 Ajustado",
            "description": "Calcula a variação percentual da Margem Comercial Ajustada comparada ao Ano Anterior.",
            "expression": [
              "// Calcula a variação percentual da Margem Comercial Ajustada em relação ao ano anterior",
              "DIVIDE(",
              "    [Margem Comercial Ajustada], ",
              "    [Margem Comercial Ajustada Ano Anterior]",
              ") - 1"
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Margem Comercial\\Variações",
            "lineageTag": "a58cf052-2fb9-47d2-a3aa-7e52bcb78d74"
          },
          {
            "name": "Real Ajustado X Meta",
            "description": "Calcula a variação percentual da Margem Comercial Ajustada em relação à Meta.",
            "expression": [
              "// Calcula a variação percentual entre a Margem Comercial Ajustada e a Meta",
              "DIVIDE(",
              "    [Margem Comercial Ajustada] - [Margem Comercial Meta (Até Ontem)],",
              "    [Margem Comercial Meta (Até Ontem)]",
              ")"
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Margem Comercial\\Variações",
            "lineageTag": "75a9a830-8764-49dc-9194-8ecd1280b6e5"
          },
          {
            "name": "MG (%) Ano-1 Ajustado",
            "description": "Calcula o percentual da Margem Comercial Ajustada em relação ao Faturamento Líquido para o Ano Anterior.",
            "expression": [
              "// Calcula o percentual de Margem Comercial Ajustada do Ano Anterior sobre o Faturamento Líquido do Ano Anterior",
              "DIVIDE(",
              "    [Margem Comercial Ajustada Ano Anterior], ",
              "    [Faturamento Líquido Ano Anterior]",
              ")"
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Margem Comercial\\Ano Anterior",
            "lineageTag": "902e1581-ff1c-4bcb-9920-04e13100597f"
          },
          {
            "name": "MG (%) Ajustado",
            "description": "Calcula o percentual da Margem Comercial Ajustada atual em relação ao Faturamento Líquido atual.",
            "expression": [
              "// Calcula o percentual de Margem Comercial Ajustada atual sobre o Faturamento Líquido atual",
              "DIVIDE(",
              "    [Margem Comercial Ajustada], ",
              "    [Faturamento Líquido]",
              ")"
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Margem Comercial\\Variações",
            "lineageTag": "7fcf171f-3352-49ec-9771-9ac3e19bb6c6"
          },
          {
            "name": "MG (%) Meta",
            "description": "Calcula o percentual da Margem Comercial Meta em relação à Meta de Venda.",
            "expression": [
              "// Calcula o percentual de Margem Comercial Meta sobre a Meta Venda",
              "DIVIDE(",
              "    [Margem Comercial Meta (Até Ontem)], ",
              "    [Meta Venda (Até Ontem)]",
              ")"
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Margem Comercial\\Variações",
            "lineageTag": "8b2d8e58-d117-4743-b822-deddbaba281f"
          },
          {
            "name": "Real x Ano-1 contr. Ajustada",
            "description": "Calcula a variação do valor absoluto de Margem Comercial Ajustada em relação ao ano anterior.",
            "expression": [
              "// Calcula a variação percentual da Margem Comercial Ajustada em relação ao ano anterior",
              "DIVIDE(",
              "    [Margem Contribuição Ajustada], ",
              "    [Margem Contribuição Ajustada Ano Anterior]",
              ") - 1",
              "",
              ""
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Margem de Contribuição\\Variações",
            "lineageTag": "d512d4a5-cb63-437b-a28c-6121ba5cbeb6"
          },
          {
            "name": "MG(%) Ano-1 contr. Ajustada",
            "description": "Calcula o percentual de Margem Comercial Ajustada do período do ano anterior em relação ao Faturamento Líquido do ano anterior.",
            "expression": [
              "// Calcula o percentual de Margem Comercial Ajustada do Ano Anterior sobre o Faturamento Líquido do Ano Anterior",
              "DIVIDE(",
              "    [Margem Contribuição Ajustada Ano Anterior], ",
              "    [Faturamento Líquido Ano Anterior]",
              ")",
              ""
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Margem de Contribuição\\Ano Anterior",
            "lineageTag": "dca4cf99-34d4-46ea-a1bd-cd4f3e114e30"
          },
          {
            "name": "MG(%) Meta contr. Ajustada",
            "description": "Calcula o percentual da Meta de Margem Comercial Ajustada em relação à Meta de Faturamento Líquido.",
            "expression": [
              "// Calcula o percentual de Margem Comercial Meta sobre a Meta Venda",
              "DIVIDE(",
              "    [Margem Contribuição Meta (Até Ontem)], ",
              "    [Meta Venda (Até Ontem)]",
              ")"
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Margem de Contribuição\\Variações",
            "lineageTag": "88f8ef53-923e-4f32-a338-399b2b7f5005"
          },
          {
            "name": "Real contr. Ajustada x Meta",
            "description": "Calcula o desvio ou variação absoluta entre a Margem Comercial Ajustada realizada e a Meta estipulada.",
            "expression": [
              "// Calcula a variação percentual entre a Margem Comercial Ajustada e a Meta",
              "DIVIDE(",
              "    [Margem Contribuição Ajustada] - [Margem Contribuição Meta (Até Ontem)],",
              "    [Margem Contribuição Meta (Até Ontem)]",
              ")",
              ""
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Margem de Contribuição\\Variações",
            "lineageTag": "45aa810b-d383-4235-b09d-10b82c443af2"
          },
          {
            "name": "MG(%) contr. Ajustada",
            "description": "Calcula o percentual da Margem Comercial Ajustada atual em relação ao Faturamento Líquido atual.",
            "expression": [
              "// Calcula o percentual de Margem Comercial Ajustada atual sobre o Faturamento Líquido atual",
              "DIVIDE(",
              "    [Margem Contribuição Ajustada], ",
              "    [Faturamento Líquido]",
              ")",
              ""
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas Diárias\\Margem de Contribuição\\Variações",
            "lineageTag": "61996573-87a7-4de0-a601-5f64be1f458c"
          },
          {
            "name": "Valor Agenda de Compra",
            "description": "Métrica consolidada final de Valor da Agenda de Compra.",
            "expression": [
              "// Consolidação total do valor financeiro das agendas de compra normais e PAA",
              "[Valor_Agenda_Compra_Atualiza_Custo] + [Valor_Agenda_Compra_Nao_Atualiza_Custo]"
            ],
            "formatString": "\"R$\" #,##0;(\"R$\" #,##0);\"R$\" * -",
            "displayFolder": "Movimento de Agendas\\Métricas Financeiras",
            "lineageTag": "b1102883-0b33-41f2-8060-9dbd0d31c6c4"
          },
          {
            "name": "Qtd Agenda Compra Atualiza Custo",
            "description": "Quantidade de agendas de compras regulares usando os filtros de auditoria de estoque.",
            "expression": [
              "// Filtros aplicados utilizando as novas colunas com nomes amigáveis e ocultas",
              "CALCULATE(",
              "    [Qtd Notas],",
              "    'Agenda - Cadastro'[COD_EMPRESA] = 1,",
              "    'Agenda - Cadastro'[Atualiza Estoque] = 1,",
              "    'Agenda - Cadastro'[Sentido da Agenda] = \"E\",",
              "    'Agenda - Cadastro'[Tipo de Notas] = \"C\",",
              "    'Agenda - Cadastro'[Dobra Automática] <> \"S\",",
              "    'Produto'[Tipo de Fornecedor] = \"F\",",
              "    NOT('Agendamentos (Dia)'[COD_AGENDA] IN {974, 30, 129, 530})",
              ")"
            ],
            "formatString": "#,##0;(#,##0);0",
            "displayFolder": "Movimento de Agendas\\Métricas de Volume",
            "lineageTag": "52ff4e1a-0833-43d1-86d2-5b4495ca8f43"
          },
          {
            "name": "Qtd Agenda Compra Nao Atualiza Custo",
            "description": "Quantidade de agendas de compra PAA / Importação (Código 16).",
            "expression": [
              "// Filtra estritamente a agenda de compra PAA/Importação (Código 16) da Empresa 1",
              "CALCULATE(",
              "    [Qtd Notas],",
              "    'Agenda - Cadastro'[COD_EMPRESA] = 1,",
              "    'Agendamentos (Dia)'[COD_AGENDA] = 16",
              ")"
            ],
            "formatString": "#,##0;(#,##0);0",
            "displayFolder": "Movimento de Agendas\\Métricas de Volume",
            "lineageTag": "752637a5-cd53-4cab-9552-47a7a205b8f7"
          },
          {
            "name": "Qtd Agenda de Compra",
            "description": "Métrica consolidada final de Quantidade de Agenda de Compra.",
            "expression": [
              "// Consolidação total do volume das agendas de compra normais e PAA",
              "[Qtd Agenda Compra Atualiza Custo] + [Qtd Agenda Compra Nao Atualiza Custo]"
            ],
            "formatString": "#,##0;(#,##0);0",
            "displayFolder": "Movimento de Agendas\\Métricas de Volume",
            "lineageTag": "59ebe458-ddb1-4150-9f1d-a765908463e1"
          },
          {
            "name": "Valor_Agenda_Compra_Atualiza_Custo",
            "description": "Valor total das agendas de compras regulares usando os filtros de auditoria de estoque.",
            "expression": [
              "// Filtros financeiros aplicados utilizando as novas colunas com nomes amigáveis e ocultas",
              "CALCULATE(",
              "    [Total],",
              "    'Agenda - Cadastro'[COD_EMPRESA] = 1,",
              "    'Agenda - Cadastro'[Atualiza Estoque] = 1,",
              "    'Agenda - Cadastro'[Sentido da Agenda] = \"E\",",
              "    'Agenda - Cadastro'[Tipo de Notas] = \"C\",",
              "    'Agenda - Cadastro'[Dobra Automática] <> \"S\",",
              "    'Produto'[Tipo de Fornecedor] = \"F\",",
              "    NOT('Agendamentos (Dia)'[COD_AGENDA] IN {974, 30, 129, 530})",
              ")"
            ],
            "formatString": "\"R$\" #,##0;(\"R$\" #,##0);\"R$\" * -",
            "displayFolder": "Movimento de Agendas\\Métricas Financeiras",
            "lineageTag": "4ecab286-0dc3-464b-93e8-3d10641de292"
          },
          {
            "name": "Valor_Agenda_Compra_Nao_Atualiza_Custo",
            "description": "Valor total das agendas de compra PAA / Importação (Código 16).",
            "expression": [
              "// Filtra estritamente o valor total da agenda de compra PAA/Importação (Código 16) da Empresa 1",
              "CALCULATE(",
              "    [Total],",
              "    'Agenda - Cadastro'[COD_EMPRESA] = 1,",
              "    'Agendamentos (Dia)'[COD_AGENDA] = 16",
              ")"
            ],
            "formatString": "\"R$\" #,##0;(\"R$\" #,##0);\"R$\" * -",
            "displayFolder": "Movimento de Agendas\\Métricas Financeiras",
            "lineageTag": "87bdcabb-6b70-4d80-8707-ac8f7c7c082b"
          },
          {
            "name": "Qtd Agenda de Compra Ano Anterior",
            "description": "Retorna o valor de Qtd Agenda de Compra para o mesmo período do ano anterior, limitado estritamente até o dia de hoje.",
            "expression": [
              "IF(",
              "    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,",
              "    CALCULATE(",
              "        [Qtd Agenda de Compra],",
              "        SAMEPERIODLASTYEAR('Calendário'[Dia])",
              "    )",
              ")"
            ],
            "formatString": "#,##0;(#,##0);0",
            "displayFolder": "Movimento de Agendas\\Métricas de Volume\\Ano Anterior",
            "lineageTag": "af47f3f4-bfef-4ffc-88f4-172d8849ca9f"
          },
          {
            "name": "Qtd Agenda de Compra Var Abs",
            "description": "Variação absoluta da quantidade de agendas de compra em relação ao mesmo período do ano anterior (Ano Atual - Ano Anterior).",
            "expression": "[Qtd Agenda de Compra] - [Qtd Agenda de Compra Ano Anterior]",
            "formatString": "#,##0;(#,##0);0",
            "displayFolder": "Movimento de Agendas\\Métricas de Volume\\Variações",
            "lineageTag": "6efdeae4-38a9-41ea-9ff3-505e9a80c4dd"
          },
          {
            "name": "Qtd Agenda de Compra Var %",
            "description": "Variação percentual da quantidade de agendas de compra comparando o ano atual contra o mesmo período do ano anterior.",
            "expression": "DIVIDE([Qtd Agenda de Compra Var Abs], [Qtd Agenda de Compra Ano Anterior])",
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Movimento de Agendas\\Métricas de Volume\\Variações",
            "lineageTag": "b055ff29-9db6-4351-a951-dca2a6c6b2a6"
          },
          {
            "name": "Valor Agenda de Compra Ano Anterior",
            "description": "Retorna o valor de Valor Agenda de Compra para o mesmo período do ano anterior, limitado estritamente até o dia de hoje.",
            "expression": [
              "IF(",
              "    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,",
              "    CALCULATE(",
              "        [Valor Agenda de Compra],",
              "        SAMEPERIODLASTYEAR('Calendário'[Dia])",
              "    )",
              ")"
            ],
            "formatString": "\"R$\" #,##0;(\"R$\" #,##0);\"R$\" * -",
            "displayFolder": "Movimento de Agendas\\Métricas Financeiras\\Ano Anterior",
            "lineageTag": "65e42058-a423-4830-a89b-d723cf935720"
          },
          {
            "name": "Valor Agenda de Compra Var Abs",
            "description": "Variação absoluta do valor financeiro das agendas de compra em relação ao mesmo período do ano anterior (Ano Atual - Ano Anterior).",
            "expression": "[Valor Agenda de Compra] - [Valor Agenda de Compra Ano Anterior]",
            "formatString": "\"R$\" #,##0;(\"R$\" #,##0);\"R$\" * -",
            "displayFolder": "Movimento de Agendas\\Métricas Financeiras\\Variações",
            "lineageTag": "9304750b-102d-488e-a29f-6d87c28da789"
          },
          {
            "name": "Valor Agenda de Compra Var %",
            "description": "Variação percentual do valor financeiro das agendas de compra comparando o ano atual contra o mesmo período do ano anterior.",
            "expression": "DIVIDE([Valor Agenda de Compra Var Abs], [Valor Agenda de Compra Ano Anterior])",
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Movimento de Agendas\\Métricas Financeiras\\Variações",
            "lineageTag": "f23359a3-2354-4d14-a627-efe1863cba30"
          },
          {
            "name": "Tonelagem Agenda Compra Atualiza Custo",
            "description": "Tonelagem de agendas de compras regulares usando os filtros de auditoria de estoque.",
            "expression": [
              "CALCULATE(",
              "    SUMX('Agendamentos (Dia)', 'Agendamentos (Dia)'[QTD_NOTA] * 'Agendamentos (Dia)'[QTD_PESO_LIQUIDO]),",
              "    'Agenda - Cadastro'[COD_EMPRESA] = 1,",
              "    'Agenda - Cadastro'[Atualiza Estoque] = 1,",
              "    'Agenda - Cadastro'[Sentido da Agenda] = \"E\",",
              "    'Agenda - Cadastro'[Tipo de Notas] = \"C\",",
              "    'Agenda - Cadastro'[Dobra Automática] <> \"S\",",
              "    'Produto'[Tipo de Fornecedor] = \"F\",",
              "    NOT('Agendamentos (Dia)'[COD_AGENDA] IN {974, 30, 129, 530})",
              ")"
            ],
            "formatString": "#,##0;(#,##0);0",
            "displayFolder": "Movimento de Agendas\\Métricas de Volume",
            "lineageTag": "ff9c9a8f-2374-4728-8f34-1f8113a4c87a"
          },
          {
            "name": "Tonelagem Agenda Compra Nao Atualiza Custo",
            "description": "Tonelagem de agendas de compra PAA / Importação (Código 16).",
            "expression": [
              "CALCULATE(",
              "    SUMX('Agendamentos (Dia)', 'Agendamentos (Dia)'[QTD_NOTA] * 'Agendamentos (Dia)'[QTD_PESO_LIQUIDO]),",
              "    'Agenda - Cadastro'[COD_EMPRESA] = 1,",
              "    'Agendamentos (Dia)'[COD_AGENDA] = 16",
              ")"
            ],
            "formatString": "#,##0;(#,##0);0",
            "displayFolder": "Movimento de Agendas\\Métricas de Volume",
            "lineageTag": "99f09d5d-2bbf-4b36-a988-5e437829d888"
          },
          {
            "name": "Tonelagem Agenda de Compra",
            "description": "Métrica consolidada final de Tonelagem de Agenda de Compra.",
            "expression": "[Tonelagem Agenda Compra Atualiza Custo] + [Tonelagem Agenda Compra Nao Atualiza Custo]",
            "formatString": "#,##0;(#,##0);0",
            "displayFolder": "Movimento de Agendas\\Métricas de Volume",
            "lineageTag": "5dd726dd-d1e1-4a82-b58f-59539dd85ce9"
          },
          {
            "name": "Tonelagem Agenda de Compra Ano Anterior",
            "description": "Retorna o valor de Tonelagem Agenda de Compra para o mesmo período do ano anterior.",
            "expression": [
              "IF(",
              "    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,",
              "    CALCULATE(",
              "        [Tonelagem Agenda de Compra],",
              "        SAMEPERIODLASTYEAR('Calendário'[Dia])",
              "    )",
              ")"
            ],
            "formatString": "#,##0;(#,##0);0",
            "displayFolder": "Movimento de Agendas\\Métricas de Volume\\Ano Anterior",
            "lineageTag": "22a6b300-01d6-4108-ae54-235419927ba6"
          },
          {
            "name": "Tonelagem Agenda de Compra Var Abs",
            "description": "Variação absoluta da tonelagem de agendas de compra em relação ao mesmo período do ano anterior (Ano Atual - Ano Anterior).",
            "expression": "[Tonelagem Agenda de Compra] - [Tonelagem Agenda de Compra Ano Anterior]",
            "formatString": "#,##0;(#,##0);0",
            "displayFolder": "Movimento de Agendas\\Métricas de Volume\\Variações",
            "lineageTag": "28994e8c-63dd-4182-8163-4f80f2e2cfa6"
          },
          {
            "name": "Tonelagem Agenda de Compra Var %",
            "description": "Variação percentual da tonelagem de agendas de compra comparando o ano atual contra o mesmo período do ano anterior.",
            "expression": "DIVIDE([Tonelagem Agenda de Compra Var Abs], [Tonelagem Agenda de Compra Ano Anterior])",
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Movimento de Agendas\\Métricas de Volume\\Variações",
            "lineageTag": "1a2f17ef-4f37-4c79-9fac-ea921b9066a7"
          },
          {
            "name": "Part % Clientes Hora Filial",
            "description": "Calcula dinamicamente a participação do cliente dependendo do nível ativo na hierarquia de produtos.",
            "expression": [
              "DIVIDE(",
              "    [Qtd Clientes Hora Filial],",
              "    SWITCH(",
              "        TRUE(),",
              "        ISINSCOPE('Produto'[Produto Completo]), CALCULATE([Qtd Clientes Hora Filial], ALLSELECTED('Produto'[Produto Completo])),",
              "        ISINSCOPE('Produto'[Subsegmento]), CALCULATE([Qtd Clientes Hora Filial], ALLSELECTED('Produto'[Subsegmento])),",
              "        ISINSCOPE('Produto'[Segmento]), CALCULATE([Qtd Clientes Hora Filial], ALLSELECTED('Produto'[Segmento])),",
              "        ISINSCOPE('Produto'[Subcategoria]), CALCULATE([Qtd Clientes Hora Filial], ALLSELECTED('Produto'[Subcategoria])),",
              "        CALCULATE([Qtd Clientes Hora Filial], ALLSELECTED('Produto'[Categoria]))",
              "    )",
              ")"
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas por Hora\\Penetração",
            "lineageTag": "f98d3aa4-5e2f-4903-8c39-b8bd70d691b4"
          },
          {
            "name": "Part % Tickets Hora Filial",
            "description": "Calcula dinamicamente a participação do ticket dependendo do nível ativo na hierarquia de produtos.",
            "expression": [
              "DIVIDE(",
              "    [Qtd Tickets Hora Filial],",
              "    SWITCH(",
              "        TRUE(),",
              "        ISINSCOPE('Produto'[Produto Completo]), CALCULATE([Qtd Tickets Hora Filial], ALLSELECTED('Produto'[Produto Completo])),",
              "        ISINSCOPE('Produto'[Subsegmento]), CALCULATE([Qtd Tickets Hora Filial], ALLSELECTED('Produto'[Subsegmento])),",
              "        ISINSCOPE('Produto'[Segmento]), CALCULATE([Qtd Tickets Hora Filial], ALLSELECTED('Produto'[Segmento])),",
              "        ISINSCOPE('Produto'[Subcategoria]), CALCULATE([Qtd Tickets Hora Filial], ALLSELECTED('Produto'[Subcategoria])),",
              "        CALCULATE([Qtd Tickets Hora Filial], ALLSELECTED('Produto'[Categoria]))",
              "    )",
              ")"
            ],
            "formatString": "0.00%;(0.00%);0.00%",
            "displayFolder": "Vendas por Hora\\Penetração",
            "lineageTag": "e062f4e8-a37c-4f4b-a568-11f30b1477bb"
          },
