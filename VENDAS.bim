        "measures": [
          {
            "name": "Filial Visual",
            "description": "Medida utilizada para exibir o nome da filial em dicas de ferramenta de visuais.",
            "expression": "SELECTEDVALUE('Lojas'[Filial])",
            "formatString": "@",
            "displayFolder": "Medidas de Suporte",
            "lineageTag": "efea8a01-1ee7-40e2-9619-65c9c7526ac5"
          },
          {
            "name": "Cor_Grafico_Filial",
            "expression": [
              "VAR _Texto = MAX('Lojas'[Filial])",
              "-- Pega o código ASCII da última letra/número da filial para garantir variação de cores",
              "VAR _UltimoCaractere = RIGHT(_Texto, 1)",
              "VAR _Comprimento = LEN(_Texto)",
              "-- Lógica matemática simples e leve para gerar um ID de 0 a 11",
              "VAR _CorId = MOD(_Comprimento + INT(UNICODE(_UltimoCaractere)), 12)",
              "RETURN",
              "IF(",
              "    NOT(ISFILTERED('Lojas'[Filial])),",
              "    \"#A6A6A6\", -- Cinza para o Total Geral",
              "    SWITCH(",
              "        _CorId,",
              "        0, \"#118DFF\",  -- Azul Real",
              "        1, \"#12CDD9\",  -- Ciano Neon",
              "        2, \"#70A114\",  -- Verde Alface",
              "        3, \"#F2CD13\",  -- Amarelo Ouro",
              "        4, \"#E04444\",  -- Vermelho Coral",
              "        5, \"#8A44E0\",  -- Roxo Executivo",
              "        6, \"#E07B44\",  -- Laranja Quente",
              "        7, \"#00A86B\",  -- Verde Esmeralda",
              "        8, \"#FF6B6B\",  -- Salmão Pastel",
              "        9, \"#4D4DFF\",  -- Azul Elétrico",
              "        10, \"#9B59B6\", -- Ametista",
              "        \"#34495E\"      -- Grafite",
              "    )",
              ")",
              ""
            ],
            "isHidden": true,
            "displayFolder": "Medidas de Suporte",
            "lineageTag": "a9c6cd81-70b1-4d8e-84d1-7d3926664a90"
          }
        ],
