      {
        "name": "Visão Agrupamento",
        "description": "Ativa o agrupamento de subfiliais para todas as medidas sem alterar o DAX original",
        "lineageTag": "fa0e9e64-f6b7-492f-a03e-b3099c0b7a7c",
        "calculationGroup": {
          "precedence": 1,
          "calculationItems": [
            {
              "name": "Ativar Agrupamento",
              "expression": "CALCULATE(SELECTEDMEASURE(), CROSSFILTER('Lojas Agrupadas'[KEY_SUBFILIAL_INT], 'Lojas'[KEY_SUBFILIAL_INT], Both))"
            }
          ]
        },
