	/// Média diária de Faturamento Líquido considerando os dias decorridos até ontem no mês.
	measure 'Venda Média Dia' = ```
			VAR _DiasDecorridos = 
			    CALCULATE(
			        COUNTROWS('Calendário'),
			        KEEPFILTERS('Calendário'[Flag Data Passada] = 1),
			        ALLEXCEPT('Calendário', 'Calendário'[COD_MES])
			    )
			
			RETURN
			    DIVIDE(
			        [Faturamento Líquido],
			        _DiasDecorridos
			    )
			```
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Faturamento
		lineageTag: 32108e98-ac9e-4421-9a19-50bf2c42c17e

	/// Venda Média Dia para o mesmo período do ano anterior, limitada estritamente até o dia de hoje.
	measure 'Venda Média Dia Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Venda Média Dia],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Faturamento\Ano Anterior
		lineageTag: 18671c13-909c-4b75-89dc-9e5d8ea5b7ea

	/// Soma do Custo Líquido do mesmo período do ano anterior com os Ajustes Gerenciais do PDV do ano anterior (ex: Estoque Negativo, Verba Custo Mês Anterior, Diferença Custo CD, Acordo Comercial, etc.).
	measure 'Custo Líquido com Ajuste Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Custo Líquido com Ajuste],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Custos\Ano Anterior
		lineageTag: 796cb2a4-cae6-43bc-b1e5-cc54ecb000e4

	/// Calcula a Margem Comercial do mesmo período do ano anterior.
	measure 'Margem Comercial Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Margem Comercial],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Vendas Diárias\Margem Comercial\Ano Anterior
		lineageTag: 7fc5b7b0-7672-4af7-ac81-40e30c30ce7b

	/// Calcula a Margem de Contribuição do mesmo período do ano anterior.
	measure 'Margem Contribuição Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Margem Contribuição],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Vendas Diárias\Margem de Contribuição\Ano Anterior
		lineageTag: f57de761-177f-4bba-b954-48d0d0920b27

	/// Soma do Custo Líquido do período atual com os Ajustes Gerenciais do PDV (ex: Estoque Negativo, Verba Custo Mês Anterior, Diferença Custo CD, Acordo Comercial, etc.).
	measure 'Custo Líquido com Ajuste' = [Custo Líquido] + [Valor Custo Apurado]
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Vendas Diárias\Custos
		lineageTag: 7426abc7-f748-4b1e-a0e7-8fb57bdff346

	/// Calcula a Margem Comercial do período atual (Faturamento Líquido deduções de ICMS Líquido, PIS/COFINS Líquido e Custo Líquido com Ajuste).
	measure 'Margem Comercial' = ```
			
			    [Faturamento Líquido] 
			    - [ICMS Líquido] 
			    - [PIS COFINS Líquido] 
			    - [Custo Líquido com Ajuste]
			
			```
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Vendas Diárias\Margem Comercial
		lineageTag: b00edd0c-320d-4009-8f02-69e82b0cee34

		annotation PBI_FormatHint = {"isDecimal":true}

	/// Calcula a Margem de Contribuição do período atual (Margem Comercial deduções de Embalagem e Perdas Totais).
	measure 'Margem Contribuição' = ```
			
			    [Margem Comercial] 
			    - [Valor Embalagem] 
			    - [Valor Total Perda]
			
			```
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Vendas Diárias\Margem de Contribuição
		lineageTag: c0ca6a16-8eda-4a51-bac0-f95e939e049c

	/// Margem de Contribuição do período atual somada aos Ajustes de Margem de Contribuição e Verbas.
	measure 'Margem Contribuição Ajustada' = ```
			
			    [Margem Contribuição] 
			    + [Valor Ajuste Margem Contribuição] 
			    + [Valor Verba]
			
			```
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Vendas Diárias\Margem de Contribuição
		lineageTag: fc2ad4a2-ccad-4578-b0f0-6ea45077d317

	/// Margem de Contribuição do mesmo período do ano anterior somada aos Ajustes de Margem de Contribuição e Verbas do ano anterior.
	measure 'Margem Contribuição Ajustada Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Margem Contribuição Ajustada],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Vendas Diárias\Margem de Contribuição\Ano Anterior
		lineageTag: 3f9a3912-8028-4128-bcab-f8c0453129e8

	/// Margem Comercial do período atual somada aos Ajustes Gerenciais e Verbas.
	measure 'Margem Comercial Ajustada' = ```
			
			    [Margem Comercial] 
			    + [Valor Ajuste Gerencial] 
			    + [Valor Verba]
			
			```
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Vendas Diárias\Margem Comercial
		lineageTag: c53c74fd-1443-4b52-8329-bf33afd2753f

	/// Margem Comercial do mesmo período do ano anterior somada aos Ajustes Gerenciais e Verbas do ano anterior.
	measure 'Margem Comercial Ajustada Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Margem Comercial Ajustada],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Vendas Diárias\Margem Comercial\Ano Anterior
		lineageTag: 1347d8a2-eb31-49ef-a7e6-2aeabe571607

	/// Retorna o valor de Margem Comercial Meta (Até Ontem) para o mesmo período do ano anterior, limitado estritamente até o dia de hoje.
	measure 'Margem Comercial Meta (Até Ontem) Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Margem Comercial Meta (Até Ontem)],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Metas\Metas Financeiras\Ano Anterior
		lineageTag: a2e9f431-1c41-4290-8a68-2217e91f210b

	/// Retorna o valor de Margem Contribuição Meta (Até Ontem) para o mesmo período do ano anterior, limitado estritamente até o dia de hoje.
	measure 'Margem Contribuição Meta (Até Ontem) Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Margem Contribuição Meta (Até Ontem)],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Metas\Metas Financeiras\Ano Anterior
		lineageTag: b1c939de-343e-4d1d-8456-9fe2dc2e143f

	/// Retorna o valor de Meta Perda (Até Ontem) para o mesmo período do ano anterior, limitado estritamente até o dia de hoje.
	measure 'Meta Perda (Até Ontem) Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Meta Perda (Até Ontem)],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Metas\Metas Financeiras\Ano Anterior
		lineageTag: 675cc3f0-4001-4b32-8edd-7e30db62019f

	/// Diferença absoluta entre o valor atual de Margem Comercial Meta (Até Ontem) e o mesmo período do ano anterior.
	measure 'Margem Comercial Meta (Até Ontem) Var R$' = [Margem Comercial Meta (Até Ontem)] - [Margem Comercial Meta (Até Ontem) Ano Anterior]
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Metas\Metas Financeiras\Variações
		lineageTag: 8472cb5b-7a83-4c4c-9a9c-481ce265be1f

	/// Variação percentual de Margem Comercial Meta em relação ao mesmo período do ano anterior.
	measure 'Margem Comercial Meta (Até Ontem) Var %' = DIVIDE([Margem Comercial Meta (Até Ontem) Var R$], [Margem Comercial Meta (Até Ontem) Ano Anterior])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Metas\Metas Financeiras\Variações
		lineageTag: 329b1d4d-7cc7-4b5b-b45a-5c9da58899ca

	/// Diferença absoluta entre o valor atual de Margem Contribuição Meta (Até Ontem) e o mesmo período do ano anterior.
	measure 'Margem Contribuição Meta (Até Ontem) Var R$' = [Margem Contribuição Meta (Até Ontem)] - [Margem Contribuição Meta (Até Ontem) Ano Anterior]
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Metas\Metas Financeiras\Variações
		lineageTag: 473db7f7-d65c-4d49-8be7-7ef0db2d743f

	/// Variação percentual de Margem Contribuição Meta em relação ao mesmo período do ano anterior.
	measure 'Margem Contribuição Meta (Até Ontem) Var %' = DIVIDE([Margem Contribuição Meta (Até Ontem) Var R$], [Margem Contribuição Meta (Até Ontem) Ano Anterior])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Metas\Metas Financeiras\Variações
		lineageTag: ecc58792-0881-4a01-af32-c27a58e16588

	/// Quantidade distinta de clientes atendidos na hora por filial.
	measure 'Qtd Clientes Hora Filial' = DISTINCTCOUNTNOBLANK('Vendas por Hora'[COD_CLIENTE])
		formatString: #,##0;-#,##0;0
		displayFolder: Vendas por Hora\Atendimento
		lineageTag: 0651d9b6-6d4b-413e-a082-58cbc24d986b

	/// Quantidade distinta de cupons/tickets emitidos na hora por filial.
	measure 'Qtd Tickets Hora Filial' = DISTINCTCOUNTNOBLANK('Vendas por Hora'[COD_CUPOM_VENDA])
		formatString: #,##0;-#,##0;0
		displayFolder: Vendas por Hora\Atendimento
		lineageTag: b21df289-4140-413f-9614-b47dc9541073

	/// Quantidade de clientes no mesmo período do ano anterior (considerando apenas dias passados).
	measure 'Qtd Clientes Hora Filial Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Qtd Clientes Hora Filial],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: #,##0;-#,##0;0
		displayFolder: Vendas por Hora\Atendimento\Ano Anterior
		lineageTag: c3756d11-bad7-4d37-a553-1ba0b910ca77

	/// Quantidade de tickets no mesmo período do ano anterior (considerando apenas dias passados).
	measure 'Qtd Tickets Hora Filial Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Qtd Tickets Hora Filial],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: #,##0;-#,##0;0
		displayFolder: Vendas por Hora\Atendimento\Ano Anterior
		lineageTag: 81d135f5-b85d-40b8-b4fa-32ffb88f7e22

	/// Variação absoluta de clientes atendidos em relação ao ano anterior.
	measure 'Qtd Clientes Hora Filial Var Abs' = [Qtd Clientes Hora Filial] - [Qtd Clientes Hora Filial Ano Anterior]
		formatString: #,##0;-#,##0;0
		displayFolder: Vendas por Hora\Atendimento\Variações
		lineageTag: aaa72894-3902-46be-a31c-6b4ff728ecfe

	/// Variação percentual de clientes atendidos em relação ao ano anterior.
	measure 'Qtd Clientes Hora Filial Var %' = DIVIDE([Qtd Clientes Hora Filial Var Abs], [Qtd Clientes Hora Filial Ano Anterior])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Atendimento\Variações
		lineageTag: b0b39f1c-a2e0-4bb1-b75b-bc9392a10388

	/// Variação absoluta de tickets emitidos em relação ao ano anterior.
	measure 'Qtd Tickets Hora Filial Var Abs' = [Qtd Tickets Hora Filial] - [Qtd Tickets Hora Filial Ano Anterior]
		formatString: #,##0;-#,##0;0
		displayFolder: Vendas por Hora\Atendimento\Variações
		lineageTag: 4d78ec41-aa8e-492c-b12e-ab685ec61d60

	/// Variação percentual de tickets emitidos em relação ao ano anterior.
	measure 'Qtd Tickets Hora Filial Var %' = DIVIDE([Qtd Tickets Hora Filial Var Abs], [Qtd Tickets Hora Filial Ano Anterior])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Atendimento\Variações
		lineageTag: 779776b2-16cc-4b52-bc6d-b6f3a3a9ef8f

	/// Medida de acompanhamento da Matriz do Relatório Executivo.
	measure 'Vlr Sobra/falta' = [Faturamento Líquido] - [Meta Venda (Até Ontem)]
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Faturamento
		lineageTag: 94d34d79-0697-4694-95a8-f19ba5070725

	/// Medida de acompanhamento da Matriz do Relatório Executivo.
	measure 'Sobra/Falta - dias' = DIVIDE([Vlr Sobra/falta], [Venda Média Dia], 0)
		formatString: #,##0.00;-#,##0.00;0.00
		displayFolder: Vendas Diárias\Faturamento
		lineageTag: eaa8bcc1-5b68-42dd-8b1b-31b358371dfc

	/// Medida de acompanhamento da Matriz do Relatório Executivo.
	measure 'Real x Meta' = DIVIDE([Faturamento Líquido] - [Meta Venda (Até Ontem)], [Meta Venda (Até Ontem)], 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Faturamento\Variações
		lineageTag: a45224c0-ec74-4f88-922c-2a0d5e573921

	/// Medida de acompanhamento da Matriz do Relatório Executivo.
	measure 'Ano-1 (%)' = DIVIDE([Faturamento Líquido] - [Faturamento Líquido Ano Anterior], [Faturamento Líquido Ano Anterior], 0)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Faturamento\Variações
		lineageTag: 33e08583-be8b-43a0-bc83-14f36d01d019

	/// Calcula a variação percentual da Margem Comercial Ajustada comparada ao Ano Anterior.
	measure 'Real x Ano-1 Ajustado' = ```
			// Calcula a variação percentual da Margem Comercial Ajustada em relação ao ano anterior
			DIVIDE(
			    [Margem Comercial Ajustada], 
			    [Margem Comercial Ajustada Ano Anterior]
			) - 1
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Margem Comercial\Variações
		lineageTag: a58cf052-2fb9-47d2-a3aa-7e52bcb78d74

	/// Calcula a variação percentual da Margem Comercial Ajustada em relação à Meta.
	measure 'Real Ajustado X Meta' =
			// Calcula a variação percentual entre a Margem Comercial Ajustada e a Meta
			DIVIDE(
			    [Margem Comercial Ajustada] - [Margem Comercial Meta (Até Ontem)],
			    [Margem Comercial Meta (Até Ontem)]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Margem Comercial\Variações
		lineageTag: 75a9a830-8764-49dc-9194-8ecd1280b6e5

	/// Calcula o percentual da Margem Comercial Ajustada em relação ao Faturamento Líquido para o Ano Anterior.
	measure 'MG (%) Ano-1 Ajustado' = ```
			// Calcula o percentual de Margem Comercial Ajustada do Ano Anterior sobre o Faturamento Líquido do Ano Anterior
			DIVIDE(
			    [Margem Comercial Ajustada Ano Anterior], 
			    [Faturamento Líquido Ano Anterior]
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Margem Comercial\Ano Anterior
		lineageTag: 902e1581-ff1c-4bcb-9920-04e13100597f

	/// Calcula o percentual da Margem Comercial Ajustada atual em relação ao Faturamento Líquido atual.
	measure 'MG (%) Ajustado' = ```
			// Calcula o percentual de Margem Comercial Ajustada atual sobre o Faturamento Líquido atual
			DIVIDE(
			    [Margem Comercial Ajustada], 
			    [Faturamento Líquido]
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Margem Comercial\Variações
		lineageTag: 7fcf171f-3352-49ec-9771-9ac3e19bb6c6

	/// Calcula o percentual da Margem Comercial Meta em relação à Meta de Venda.
	measure 'MG (%) Meta' = ```
			// Calcula o percentual de Margem Comercial Meta sobre a Meta Venda
			DIVIDE(
			    [Margem Comercial Meta (Até Ontem)], 
			    [Meta Venda (Até Ontem)]
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Margem Comercial\Variações
		lineageTag: 8b2d8e58-d117-4743-b822-deddbaba281f

	/// Calcula a variação do valor absoluto de Margem Comercial Ajustada em relação ao ano anterior.
	measure 'Real x Ano-1 contr. Ajustada' = ```
			// Calcula a variação percentual da Margem Comercial Ajustada em relação ao ano anterior
			DIVIDE(
			    [Margem Contribuição Ajustada], 
			    [Margem Contribuição Ajustada Ano Anterior]
			) - 1
			
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Margem de Contribuição\Variações
		lineageTag: d512d4a5-cb63-437b-a28c-6121ba5cbeb6

	/// Calcula o percentual de Margem Comercial Ajustada do período do ano anterior em relação ao Faturamento Líquido do ano anterior.
	measure 'MG(%) Ano-1 contr. Ajustada' = ```
			// Calcula o percentual de Margem Comercial Ajustada do Ano Anterior sobre o Faturamento Líquido do Ano Anterior
			DIVIDE(
			    [Margem Contribuição Ajustada Ano Anterior], 
			    [Faturamento Líquido Ano Anterior]
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Margem de Contribuição\Ano Anterior
		lineageTag: dca4cf99-34d4-46ea-a1bd-cd4f3e114e30

	/// Calcula o percentual da Meta de Margem Comercial Ajustada em relação à Meta de Faturamento Líquido.
	measure 'MG(%) Meta contr. Ajustada' = ```
			// Calcula o percentual de Margem Comercial Meta sobre a Meta Venda
			DIVIDE(
			    [Margem Contribuição Meta (Até Ontem)], 
			    [Meta Venda (Até Ontem)]
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Margem de Contribuição\Variações
		lineageTag: 88f8ef53-923e-4f32-a338-399b2b7f5005

	/// Calcula o desvio ou variação absoluta entre a Margem Comercial Ajustada realizada e a Meta estipulada.
	measure 'Real contr. Ajustada x Meta' = ```
			// Calcula a variação percentual entre a Margem Comercial Ajustada e a Meta
			DIVIDE(
			    [Margem Contribuição Ajustada] - [Margem Contribuição Meta (Até Ontem)],
			    [Margem Contribuição Meta (Até Ontem)]
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Margem de Contribuição\Variações
		lineageTag: 45aa810b-d383-4235-b09d-10b82c443af2

	/// Calcula o percentual da Margem Comercial Ajustada atual em relação ao Faturamento Líquido atual.
	measure 'MG(%) contr. Ajustada' = ```
			// Calcula o percentual de Margem Comercial Ajustada atual sobre o Faturamento Líquido atual
			DIVIDE(
			    [Margem Contribuição Ajustada], 
			    [Faturamento Líquido]
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Margem de Contribuição\Variações
		lineageTag: 61996573-87a7-4de0-a601-5f64be1f458c

	/// Métrica consolidada final de Valor da Agenda de Compra.
	measure 'Valor Agenda de Compra' =
			// Consolidação total do valor financeiro das agendas de compra normais e PAA
			[Valor_Agenda_Compra_Atualiza_Custo] + [Valor_Agenda_Compra_Nao_Atualiza_Custo]
		formatString: "R$" #,##0;-"R$" #,##0;"R$" * -
		displayFolder: Movimento de Agendas\Métricas Financeiras
		lineageTag: b1102883-0b33-41f2-8060-9dbd0d31c6c4

	/// Quantidade de agendas de compras regulares usando os filtros de auditoria de estoque.
	measure 'Qtd Agenda Compra Atualiza Custo' =
			// Filtros aplicados utilizando as novas colunas com nomes amigáveis e ocultas
			CALCULATE(
			    [Qtd Notas],
			    'Agenda - Cadastro'[COD_EMPRESA] = 1,
			    'Agenda - Cadastro'[Atualiza Estoque] = 1,
			    'Agenda - Cadastro'[Sentido da Agenda] = "E",
			    'Agenda - Cadastro'[Tipo de Notas] = "C",
			    'Agenda - Cadastro'[Dobra Automática] <> "S",
			    'Produto'[Tipo de Fornecedor] = "F",
			    NOT('Agendamentos (Dia)'[COD_AGENDA] IN {974, 30, 129, 530})
			)
		formatString: #,##0;-#,##0;0
		displayFolder: Movimento de Agendas\Métricas de Volume
		lineageTag: 52ff4e1a-0833-43d1-86d2-5b4495ca8f43

	/// Quantidade de agendas de compra PAA / Importação (Código 16).
	measure 'Qtd Agenda Compra Nao Atualiza Custo' =
			// Filtra estritamente a agenda de compra PAA/Importação (Código 16) da Empresa 1
			CALCULATE(
			    [Qtd Notas],
			    'Agenda - Cadastro'[COD_EMPRESA] = 1,
			    'Agendamentos (Dia)'[COD_AGENDA] = 16
			)
		formatString: #,##0;-#,##0;0
		displayFolder: Movimento de Agendas\Métricas de Volume
		lineageTag: 752637a5-cd53-4cab-9552-47a7a205b8f7

	/// Métrica consolidada final de Quantidade de Agenda de Compra.
	measure 'Qtd Agenda de Compra' =
			// Consolidação total do volume das agendas de compra normais e PAA
			[Qtd Agenda Compra Atualiza Custo] + [Qtd Agenda Compra Nao Atualiza Custo]
		formatString: #,##0;-#,##0;0
		displayFolder: Movimento de Agendas\Métricas de Volume
		lineageTag: 59ebe458-ddb1-4150-9f1d-a765908463e1

	/// Valor total das agendas de compras regulares usando os filtros de auditoria de estoque.
	measure Valor_Agenda_Compra_Atualiza_Custo =
			// Filtros financeiros aplicados utilizando as novas colunas com nomes amigáveis e ocultas
			CALCULATE(
			    [Total],
			    'Agenda - Cadastro'[COD_EMPRESA] = 1,
			    'Agenda - Cadastro'[Atualiza Estoque] = 1,
			    'Agenda - Cadastro'[Sentido da Agenda] = "E",
			    'Agenda - Cadastro'[Tipo de Notas] = "C",
			    'Agenda - Cadastro'[Dobra Automática] <> "S",
			    'Produto'[Tipo de Fornecedor] = "F",
			    NOT('Agendamentos (Dia)'[COD_AGENDA] IN {974, 30, 129, 530})
			)
		formatString: "R$" #,##0;-"R$" #,##0;"R$" * -
		displayFolder: Movimento de Agendas\Métricas Financeiras
		lineageTag: 4ecab286-0dc3-464b-93e8-3d10641de292

	/// Valor total das agendas de compra PAA / Importação (Código 16).
	measure Valor_Agenda_Compra_Nao_Atualiza_Custo =
			// Filtra estritamente o valor total da agenda de compra PAA/Importação (Código 16) da Empresa 1
			CALCULATE(
			    [Total],
			    'Agenda - Cadastro'[COD_EMPRESA] = 1,
			    'Agendamentos (Dia)'[COD_AGENDA] = 16
			)
		formatString: "R$" #,##0;-"R$" #,##0;"R$" * -
		displayFolder: Movimento de Agendas\Métricas Financeiras
		lineageTag: 87bdcabb-6b70-4d80-8707-ac8f7c7c082b

	/// Retorna o valor de Qtd Agenda de Compra para o mesmo período do ano anterior, limitado estritamente até o dia de hoje.
	measure 'Qtd Agenda de Compra Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Qtd Agenda de Compra],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: #,##0;-#,##0;0
		displayFolder: Movimento de Agendas\Métricas de Volume\Ano Anterior
		lineageTag: af47f3f4-bfef-4ffc-88f4-172d8849ca9f

	/// Variação absoluta da quantidade de agendas de compra em relação ao mesmo período do ano anterior (Ano Atual - Ano Anterior).
	measure 'Qtd Agenda de Compra Var Abs' = [Qtd Agenda de Compra] - [Qtd Agenda de Compra Ano Anterior]
		formatString: #,##0;-#,##0;0
		displayFolder: Movimento de Agendas\Métricas de Volume\Variações
		lineageTag: 6efdeae4-38a9-41ea-9ff3-505e9a80c4dd

	/// Variação percentual da quantidade de agendas de compra comparando o ano atual contra o mesmo período do ano anterior.
	measure 'Qtd Agenda de Compra Var %' = DIVIDE([Qtd Agenda de Compra Var Abs], [Qtd Agenda de Compra Ano Anterior])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Movimento de Agendas\Métricas de Volume\Variações
		lineageTag: b055ff29-9db6-4351-a951-dca2a6c6b2a6

	/// Retorna o valor de Valor Agenda de Compra para o mesmo período do ano anterior, limitado estritamente até o dia de hoje.
	measure 'Valor Agenda de Compra Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Valor Agenda de Compra],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: "R$" #,##0;-"R$" #,##0;"R$" * -
		displayFolder: Movimento de Agendas\Métricas Financeiras\Ano Anterior
		lineageTag: 65e42058-a423-4830-a89b-d723cf935720

	/// Variação absoluta do valor financeiro das agendas de compra em relação ao mesmo período do ano anterior (Ano Atual - Ano Anterior).
	measure 'Valor Agenda de Compra Var Abs' = [Valor Agenda de Compra] - [Valor Agenda de Compra Ano Anterior]
		formatString: "R$" #,##0;-"R$" #,##0;"R$" * -
		displayFolder: Movimento de Agendas\Métricas Financeiras\Variações
		lineageTag: 9304750b-102d-488e-a29f-6d87c28da789

	/// Variação percentual do valor financeiro das agendas de compra comparando o ano atual contra o mesmo período do ano anterior.
	measure 'Valor Agenda de Compra Var %' = DIVIDE([Valor Agenda de Compra Var Abs], [Valor Agenda de Compra Ano Anterior])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Movimento de Agendas\Métricas Financeiras\Variações
		lineageTag: f23359a3-2354-4d14-a627-efe1863cba30

	/// Tonelagem de agendas de compras regulares usando os filtros de auditoria de estoque.
	measure 'Tonelagem Agenda Compra Atualiza Custo' =
			CALCULATE(
			    SUMX('Agendamentos (Dia)', 'Agendamentos (Dia)'[QTD_NOTA] * 'Agendamentos (Dia)'[QTD_PESO_LIQUIDO]),
			    'Agenda - Cadastro'[COD_EMPRESA] = 1,
			    'Agenda - Cadastro'[Atualiza Estoque] = 1,
			    'Agenda - Cadastro'[Sentido da Agenda] = "E",
			    'Agenda - Cadastro'[Tipo de Notas] = "C",
			    'Agenda - Cadastro'[Dobra Automática] <> "S",
			    'Produto'[Tipo de Fornecedor] = "F",
			    NOT('Agendamentos (Dia)'[COD_AGENDA] IN {974, 30, 129, 530})
			)
		formatString: #,##0;-#,##0;0
		displayFolder: Movimento de Agendas\Métricas de Volume
		lineageTag: ff9c9a8f-2374-4728-8f34-1f8113a4c87a

	/// Tonelagem de agendas de compra PAA / Importação (Código 16).
	measure 'Tonelagem Agenda Compra Nao Atualiza Custo' =
			CALCULATE(
			    SUMX('Agendamentos (Dia)', 'Agendamentos (Dia)'[QTD_NOTA] * 'Agendamentos (Dia)'[QTD_PESO_LIQUIDO]),
			    'Agenda - Cadastro'[COD_EMPRESA] = 1,
			    'Agendamentos (Dia)'[COD_AGENDA] = 16
			)
		formatString: #,##0;-#,##0;0
		displayFolder: Movimento de Agendas\Métricas de Volume
		lineageTag: 99f09d5d-2bbf-4b36-a988-5e437829d888

	/// Métrica consolidada final de Tonelagem de Agenda de Compra.
	measure 'Tonelagem Agenda de Compra' = [Tonelagem Agenda Compra Atualiza Custo] + [Tonelagem Agenda Compra Nao Atualiza Custo]
		formatString: #,##0;-#,##0;0
		displayFolder: Movimento de Agendas\Métricas de Volume
		lineageTag: 5dd726dd-d1e1-4a82-b58f-59539dd85ce9

	/// Retorna o valor de Tonelagem Agenda de Compra para o mesmo período do ano anterior.
	measure 'Tonelagem Agenda de Compra Ano Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Tonelagem Agenda de Compra],
			        SAMEPERIODLASTYEAR('Calendário'[Dia])
			    )
			)
		formatString: #,##0;-#,##0;0
		displayFolder: Movimento de Agendas\Métricas de Volume\Ano Anterior
		lineageTag: 22a6b300-01d6-4108-ae54-235419927ba6

	/// Variação absoluta da tonelagem de agendas de compra em relação ao mesmo período do ano anterior (Ano Atual - Ano Anterior).
	measure 'Tonelagem Agenda de Compra Var Abs' = [Tonelagem Agenda de Compra] - [Tonelagem Agenda de Compra Ano Anterior]
		formatString: #,##0;-#,##0;0
		displayFolder: Movimento de Agendas\Métricas de Volume\Variações
		lineageTag: 28994e8c-63dd-4182-8163-4f80f2e2cfa6

	/// Variação percentual da tonelagem de agendas de compra comparando o ano atual contra o mesmo período do ano anterior.
	measure 'Tonelagem Agenda de Compra Var %' = DIVIDE([Tonelagem Agenda de Compra Var Abs], [Tonelagem Agenda de Compra Ano Anterior])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Movimento de Agendas\Métricas de Volume\Variações
		lineageTag: 1a2f17ef-4f37-4c79-9fac-ea921b9066a7

	/// Calcula dinamicamente a participação do cliente dependendo do nível ativo na hierarquia de produtos.
	measure 'Part % Clientes Hora Filial' =
			DIVIDE(
			    [Qtd Clientes Hora Filial],
			    SWITCH(
			        TRUE(),
			        ISINSCOPE('Produto'[Produto Completo]), CALCULATE([Qtd Clientes Hora Filial], ALLSELECTED('Produto'[Produto Completo])),
			        ISINSCOPE('Produto'[Subsegmento]), CALCULATE([Qtd Clientes Hora Filial], ALLSELECTED('Produto'[Subsegmento])),
			        ISINSCOPE('Produto'[Segmento]), CALCULATE([Qtd Clientes Hora Filial], ALLSELECTED('Produto'[Segmento])),
			        ISINSCOPE('Produto'[Subcategoria]), CALCULATE([Qtd Clientes Hora Filial], ALLSELECTED('Produto'[Subcategoria])),
			        CALCULATE([Qtd Clientes Hora Filial], ALLSELECTED('Produto'[Categoria]))
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Penetração
		lineageTag: f98d3aa4-5e2f-4903-8c39-b8bd70d691b4

	/// Calcula dinamicamente a participação do ticket dependendo do nível ativo na hierarquia de produtos.
	measure 'Part % Tickets Hora Filial' =
			DIVIDE(
			    [Qtd Tickets Hora Filial],
			    SWITCH(
			        TRUE(),
			        ISINSCOPE('Produto'[Produto Completo]), CALCULATE([Qtd Tickets Hora Filial], ALLSELECTED('Produto'[Produto Completo])),
			        ISINSCOPE('Produto'[Subsegmento]), CALCULATE([Qtd Tickets Hora Filial], ALLSELECTED('Produto'[Subsegmento])),
			        ISINSCOPE('Produto'[Segmento]), CALCULATE([Qtd Tickets Hora Filial], ALLSELECTED('Produto'[Segmento])),
			        ISINSCOPE('Produto'[Subcategoria]), CALCULATE([Qtd Tickets Hora Filial], ALLSELECTED('Produto'[Subcategoria])),
			        CALCULATE([Qtd Tickets Hora Filial], ALLSELECTED('Produto'[Categoria]))
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Penetração
		lineageTag: e062f4e8-a37c-4f4b-a568-11f30b1477bb

	/// Calcula a participação percentual de tickets travada no nível de Categoria de Produtos.
	measure 'Part % Ticket Categoria' = DIVIDE([Qtd Tickets Hora Filial], CALCULATE([Qtd Tickets Hora Filial], ALLSELECTED('Produto'[Categoria])))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Penetração\Dica de Ferramenta
		lineageTag: 8fa820cf-8b05-4d43-9050-04f077729fc7

	/// Retorna a participação percentual de tickets no nível de Categoria para o mesmo período do ano anterior.
	measure 'Part % Ticket Categoria Ano-1' = CALCULATE([Part % Ticket Categoria], SAMEPERIODLASTYEAR('Calendário'[Dia]))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Penetração\Dica de Ferramenta
		lineageTag: ac4192ee-da92-4725-92c8-8635e4f1f18d

	/// Variação percentual entre a participação de tickets atual e a do ano anterior no nível de Categoria.
	measure 'Var% Part Ticket Categoria' = [Part % Ticket Categoria] - [Part % Ticket Categoria Ano-1]
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Penetração\Dica de Ferramenta
		lineageTag: 051d5af6-ac29-40e6-9938-982e2b0041ab

	/// Calcula a participação percentual de tickets travada no nível de Subsegmento de Produtos.
	measure 'Part % Ticket Subsegmento' = DIVIDE([Qtd Tickets Hora Filial], CALCULATE([Qtd Tickets Hora Filial], ALLSELECTED('Produto'[Subsegmento])))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Penetração\Dica de Ferramenta
		lineageTag: 3a6aaf5b-a055-4a13-988a-32d5d65f5fa2

	/// Retorna a participação percentual de tickets no nível de Subsegmento para o mesmo período do ano anterior.
	measure 'Part % Ticket Subsegmento Ano-1' = CALCULATE([Part % Ticket Subsegmento], SAMEPERIODLASTYEAR('Calendário'[Dia]))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Penetração\Dica de Ferramenta
		lineageTag: 9de50971-1c77-4055-bfe8-4d068b7cb06e

	/// Variação percentual entre a participação de tickets atual e a do ano anterior no nível de Subsegmento.
	measure 'Var% Part Ticket Subsegmento' = [Part % Ticket Subsegmento] - [Part % Ticket Subsegmento Ano-1]
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Penetração\Dica de Ferramenta
		lineageTag: 4b8ebdfc-f68a-40c5-9191-5697f4ee17ec

	/// Calcula a participação percentual de tickets travada no nível de Produto Completo.
	measure 'Part % Ticket Produto Completo' = DIVIDE([Qtd Tickets Hora Filial], CALCULATE([Qtd Tickets Hora Filial], ALLSELECTED('Produto'[Produto Completo])))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Penetração\Dica de Ferramenta
		lineageTag: 5f08fea1-76ec-4951-a9f9-715c69ee3298

	/// Retorna a participação percentual de tickets no nível de Produto Completo para o mesmo período do ano anterior.
	measure 'Part % Ticket Produto Completo Ano-1' = CALCULATE([Part % Ticket Produto Completo], SAMEPERIODLASTYEAR('Calendário'[Dia]))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Penetração\Dica de Ferramenta
		lineageTag: accfef06-55b9-44d6-adc1-d5e5dd348591

	/// Variação percentual entre a participação de tickets atual e a do ano anterior no nível de Produto Completo.
	measure 'Var% Part Ticket Produto Completo' = [Part % Ticket Produto Completo] - [Part % Ticket Produto Completo Ano-1]
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Penetração\Dica de Ferramenta
		lineageTag: 5e5b7e1b-2b0e-4189-9e0c-851edf01857f

	/// Métrica de penetração de tickets calculada para o período equivalente do ano anterior.
	measure 'Part % Tickets Hora Filial Ano Anterior' = DIVIDE([Qtd Tickets Hora Filial Ano Anterior], SWITCH(TRUE(), ISINSCOPE('Produto'[Produto Completo]), CALCULATE([Qtd Tickets Hora Filial Ano Anterior], ALLSELECTED('Produto'[Produto Completo])), ISINSCOPE('Produto'[Subsegmento]), CALCULATE([Qtd Tickets Hora Filial Ano Anterior], ALLSELECTED('Produto'[Subsegmento])), ISINSCOPE('Produto'[Segmento]), CALCULATE([Qtd Tickets Hora Filial Ano Anterior], ALLSELECTED('Produto'[Segmento])), ISINSCOPE('Produto'[Subcategoria]), CALCULATE([Qtd Tickets Hora Filial Ano Anterior], ALLSELECTED('Produto'[Subcategoria])), CALCULATE([Qtd Tickets Hora Filial Ano Anterior], ALLSELECTED('Produto'[Categoria]))))
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Penetração\Ano Anterior
		lineageTag: c04c76ab-1df4-4a4e-b3e8-f544132f478e

	/// Percentual de variação anual da penetração de tickets.
	measure 'Part % Tickets Hora Filial Var %' = DIVIDE([Part % Tickets Hora Filial] - [Part % Tickets Hora Filial Ano Anterior], [Part % Tickets Hora Filial Ano Anterior])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Penetração\Variações
		lineageTag: 73d5d1fb-bf6e-4bb2-b178-5f68a5ef930e

	/// Métrica de penetração de clientes calculada para o período equivalente do ano anterior.
	measure 'Part % Clientes Hora Filial Ano Anterior' = ```
			DIVIDE([Qtd Clientes Hora Filial Ano Anterior], 
			SWITCH(TRUE(), ISINSCOPE('Produto'[Produto Completo]), 
			CALCULATE([Qtd Clientes Hora Filial Ano Anterior], ALLSELECTED('Produto'[Produto Completo])), 
			ISINSCOPE('Produto'[Subsegmento]), CALCULATE([Qtd Clientes Hora Filial Ano Anterior],
			 ALLSELECTED('Produto'[Subsegmento])), ISINSCOPE('Produto'[Segmento]), 
			 CALCULATE([Qtd Clientes Hora Filial Ano Anterior], ALLSELECTED('Produto'[Segmento])), 
			 ISINSCOPE('Produto'[Subcategoria]), CALCULATE([Qtd Clientes Hora Filial Ano Anterior], ALLSELECTED('Produto'[Subcategoria])), 
			 CALCULATE([Qtd Clientes Hora Filial Ano Anterior], ALLSELECTED('Produto'[Categoria]))))
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Penetração\Ano Anterior
		lineageTag: 78d29d66-51a4-4c03-97ed-bae8471712b2

	/// Percentual de variação anual da penetração de clientes.
	measure 'Part % Clientes Hora Filial Var %' = DIVIDE([Part % Clientes Hora Filial] - [Part % Clientes Hora Filial Ano Anterior], [Part % Clientes Hora Filial Ano Anterior])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas por Hora\Penetração\Variações
		lineageTag: f3633bb7-78bb-453b-bf3b-77f9042469f3

	/// Medida mestre com formatação dinâmica ativada por métrica.
	measure Realizado =
			VAR _GrupoSelecao = SELECTEDVALUE('Menu Grupo'[Grupo Macro])
			VAR _MetricaSelecao = SELECTEDVALUE('Menu Métrica'[Métrica Fatiador], "Valor")
			
			RETURN
			    SWITCH(TRUE(),
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Valor", [Faturamento Líquido],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Quantidade", [Quantidade Líquida Vendida],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Tonelagem", [Tonelagem Líquida Vendida],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem Comercial (Valor)", [Margem Comercial],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem Comercial (%)", [MG (%) Ajustado],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem de Contribuição (Valor)", [Margem Contribuição],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem de Contribuição (%)", [MG(%) contr. Ajustada],
			        _GrupoSelecao = "Acordos" && _MetricaSelecao = "Valor", [Valor Verba],
			        _GrupoSelecao = "Ticket" && _MetricaSelecao = "Quantidade", [Qtd Tickets Hora Filial],
			        _GrupoSelecao = "Ticket" && _MetricaSelecao = "Penetração", [Part % Tickets Hora Filial],
			        _GrupoSelecao = "Cliente" && _MetricaSelecao = "Quantidade", [Qtd Clientes Hora Filial],
			        _GrupoSelecao = "Cliente" && _MetricaSelecao = "Penetração", [Part % Clientes Hora Filial],
			        _GrupoSelecao = "Compra" && _MetricaSelecao = "Valor", [Valor Agenda de Compra],
			        _GrupoSelecao = "Compra" && _MetricaSelecao = "Quantidade", [Qtd Agenda de Compra],
			        _GrupoSelecao = "Compra" && _MetricaSelecao = "Tonelagem", [Tonelagem Agenda de Compra],
			        _GrupoSelecao = "Perda" && _MetricaSelecao = "Valor", [Valor Total Perda],
			        _GrupoSelecao = "Perda" && _MetricaSelecao = "Quantidade", [Quantidade Perda],
			        BLANK()
			    )
		displayFolder: Menu Cascata Inteligente
		lineageTag: e61f21d6-038d-4361-82bf-d0d27c923aca

		formatStringDefinition = ```
				VAR _M = SELECTEDVALUE('Menu Métrica'[Métrica Fatiador]) 
				RETURN 
				    SWITCH(
				        TRUE(),
				        _M = "Penetração" || CONTAINSSTRING(_M, "%"), "0.0%",
				        _M = "Quantidade" || _M = "Tickets" || _M = "Clientes", "#,##0",
				        _M = "Tonelagem", "#,##0.00",
				        "R$ #,##0.00" -- Padrão para Valor ou qualquer outra métrica monetária
				    )
				```

	/// Medida mestre com formatação dinâmica ativada por métrica.
	measure Meta =
			VAR _GrupoSelecao = SELECTEDVALUE('Menu Grupo'[Grupo Macro])
			VAR _MetricaSelecao = SELECTEDVALUE('Menu Métrica'[Métrica Fatiador], "Valor")
			
			RETURN
			    SWITCH(TRUE(),
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Valor", [Meta Venda (Até Ontem)],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem Comercial (Valor)", [Margem Comercial Meta (Até Ontem)],
			        _GrupoSelecao = "Perda" && _MetricaSelecao = "Valor", [Meta Perda (Até Ontem)],
			        BLANK()
			    )
		displayFolder: Menu Cascata Inteligente
		lineageTag: b856dea8-2250-4f39-8fa3-b715d5c92438

		formatStringDefinition = ```
				VAR _M = SELECTEDVALUE('Menu Métrica'[Métrica Fatiador]) 
				RETURN 
				    SWITCH(
				        TRUE(),
				        _M = "Penetração" || CONTAINSSTRING(_M, "%"), "0.0%",
				        _M = "Quantidade" || _M = "Tickets" || _M = "Clientes", "#,##0",
				        _M = "Tonelagem", "#,##0.00",
				        "R$ #,##0.00" -- Padrão para Valor ou qualquer outra métrica monetária
				    )
				```

	/// Medida mestre com formatação dinâmica ativada por métrica.
	measure 'Ano Anterior' =
			VAR _GrupoSelecao = SELECTEDVALUE('Menu Grupo'[Grupo Macro])
			VAR _MetricaSelecao = SELECTEDVALUE('Menu Métrica'[Métrica Fatiador], "Valor")
			
			RETURN
			    SWITCH(TRUE(),
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Valor", [Faturamento Líquido Ano Anterior],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Quantidade", [Quantidade Líquida Vendida Ano Anterior],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Tonelagem", [Tonelagem Líquida Vendida Ano Anterior],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem Comercial (Valor)", [Margem Comercial Ano Anterior],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem Comercial (%)", [MG (%) Ano-1 Ajustado],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem de Contribuição (Valor)", [Margem Contribuição Ano Anterior],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem de Contribuição (%)", [MG(%) Ano-1 contr. Ajustada],
			        _GrupoSelecao = "Acordos" && _MetricaSelecao = "Valor", [Valor Verba Ano Anterior],
			        _GrupoSelecao = "Ticket" && _MetricaSelecao = "Quantidade", [Qtd Tickets Hora Filial Ano Anterior],
			        _GrupoSelecao = "Ticket" && _MetricaSelecao = "Penetração", [Part % Tickets Hora Filial Ano Anterior],
			        _GrupoSelecao = "Cliente" && _MetricaSelecao = "Quantidade", [Qtd Clientes Hora Filial Ano Anterior],
			        _GrupoSelecao = "Cliente" && _MetricaSelecao = "Penetração", [Part % Clientes Hora Filial Ano Anterior],
			        _GrupoSelecao = "Compra" && _MetricaSelecao = "Valor", [Valor Agenda de Compra Ano Anterior],
			        _GrupoSelecao = "Compra" && _MetricaSelecao = "Quantidade", [Qtd Agenda de Compra Ano Anterior],
			        _GrupoSelecao = "Compra" && _MetricaSelecao = "Tonelagem", [Tonelagem Agenda de Compra Ano Anterior],
			        _GrupoSelecao = "Perda" && _MetricaSelecao = "Valor", [Valor Total Perda Ano Anterior],
			        _GrupoSelecao = "Perda" && _MetricaSelecao = "Quantidade", [Quantidade Perda Ano Anterior],
			        BLANK()
			    )
		displayFolder: Menu Cascata Inteligente
		lineageTag: cfe532f7-3851-4452-81a9-5b21e7d16799

		formatStringDefinition = ```
				VAR _M = SELECTEDVALUE('Menu Métrica'[Métrica Fatiador]) 
				RETURN 
				    SWITCH(
				        TRUE(),
				        _M = "Penetração" || CONTAINSSTRING(_M, "%"), "0.0%",
				        _M = "Quantidade" || _M = "Tickets" || _M = "Clientes", "#,##0",
				        _M = "Tonelagem", "#,##0.00",
				        "R$ #,##0.00" -- Padrão para Valor ou qualquer outra métrica monetária
				    )
				```

	/// Medida mestre com formatação dinâmica ativada por métrica.
	measure 'Var %' =
			VAR _GrupoSelecao = SELECTEDVALUE('Menu Grupo'[Grupo Macro])
			VAR _MetricaSelecao = SELECTEDVALUE('Menu Métrica'[Métrica Fatiador], "Valor")
			
			RETURN
			    SWITCH(TRUE(),
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Valor", [Faturamento Líquido Var %],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Quantidade", [Quantidade Líquida Vendida Var %],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Tonelagem", [Tonelagem Líquida Vendida Var %],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem Comercial (Valor)", [Real x Ano-1 Ajustado],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem de Contribuição (Valor)", [Real x Ano-1 contr. Ajustada],
			        _GrupoSelecao = "Acordos" && _MetricaSelecao = "Valor", [Valor Verba Var %],
			        _GrupoSelecao = "Ticket" && _MetricaSelecao = "Penetração", [Part % Tickets Hora Filial Var %],
			        _GrupoSelecao = "Cliente" && _MetricaSelecao = "Penetração", [Part % Clientes Hora Filial Var %],
			        _GrupoSelecao = "Compra" && _MetricaSelecao = "Valor", [Valor Agenda de Compra Var %],
			        _GrupoSelecao = "Compra" && _MetricaSelecao = "Quantidade", [Qtd Agenda de Compra Var %],
			        _GrupoSelecao = "Compra" && _MetricaSelecao = "Tonelagem", [Tonelagem Agenda de Compra Var %],
			        _GrupoSelecao = "Perda" && _MetricaSelecao = "Valor", [Valor Total Perda Var %],
			        _GrupoSelecao = "Perda" && _MetricaSelecao = "Quantidade", [Quantidade Perda Var %],
			        BLANK()
			    )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Menu Cascata Inteligente
		lineageTag: da4c6a7b-b731-4143-9d8a-839f01a0e93d

	/// Medida mestre com formatação dinâmica ativada por métrica.
	measure 'Realizado x Meta' =
			VAR _GrupoSelecao = SELECTEDVALUE('Menu Grupo'[Grupo Macro])
			VAR _MetricaSelecao = SELECTEDVALUE('Menu Métrica'[Métrica Fatiador], "Valor")
			
			RETURN
			    SWITCH(TRUE(),
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Valor", [Real x Meta],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem Comercial (%)", [Real Ajustado X Meta],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem de Contribuição (%)", [Real contr. Ajustada x Meta],
			        BLANK()
			    )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Menu Cascata Inteligente
		lineageTag: e2013fc9-dc69-4cba-b60d-d2fb224b6410

	/// Retorna o valor de Faturamento Líquido para o mesmo período do mês anterior, limitado estritamente até o dia de hoje.
	measure 'Faturamento Líquido Mês Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Faturamento Líquido],
			        DATEADD('Calendário'[Dia], -1, MONTH)
			    )
			)
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Comparativos Curto Prazo\Mês Anterior
		lineageTag: fdd4d98a-dbfc-4167-ac89-f4a15a875cc6

	/// Diferença absoluta entre o Faturamento Líquido atual e o do mês anterior (MoM).
	measure 'Faturamento Líquido Var R$ MoM' = [Faturamento Líquido] - [Faturamento Líquido Mês Anterior]
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Comparativos Curto Prazo\Mês Anterior
		lineageTag: 82ecc04f-8d9a-4524-b821-815358cac3c5

	/// Variação percentual do Faturamento Líquido em relação ao mês anterior (MoM).
	measure 'Faturamento Líquido Var % MoM' =
			DIVIDE(
			    [Faturamento Líquido] - [Faturamento Líquido Mês Anterior],
			    [Faturamento Líquido Mês Anterior]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Comparativos Curto Prazo\Mês Anterior
		lineageTag: 24cd0c38-eb9d-49a6-a472-17cea2a7c132

	/// Retorna o valor de Margem Comercial Ajustada para o mesmo período do mês anterior, limitado estritamente até o dia de hoje.
	measure 'Margem Comercial Ajustada Mês Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Margem Comercial Ajustada],
			        DATEADD('Calendário'[Dia], -1, MONTH)
			    )
			)
		formatString: R$ #,##0;-R$ #,##0;R$ 0
		displayFolder: Vendas Diárias\Comparativos Curto Prazo\Mês Anterior
		lineageTag: 92d00eac-1a15-42f2-b566-d23a747a8ecb

	/// Variação percentual da Margem Comercial Ajustada em relação ao mês anterior (MoM).
	measure 'Margem Comercial Ajustada Var % MoM' =
			DIVIDE(
			    [Margem Comercial Ajustada] - [Margem Comercial Ajustada Mês Anterior],
			    [Margem Comercial Ajustada Mês Anterior]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Comparativos Curto Prazo\Mês Anterior
		lineageTag: ccc3fc15-1a51-4ea0-b19e-5161a66ed38e

	/// Retorna o valor de Faturamento Líquido para os mesmos dias da semana anterior (deslocamento de 7 dias), limitado estritamente até o dia de hoje.
	measure 'Faturamento Líquido Semana Anterior' =
			IF(
			    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,
			    CALCULATE(
			        [Faturamento Líquido],
			        DATEADD('Calendário'[Dia], -7, DAY)
			    )
			)
		formatString: R$ #,##0;-R$ #,##0; -
		displayFolder: Vendas Diárias\Comparativos Curto Prazo\Semana Anterior
		lineageTag: 032ebdf7-1944-49ca-b6e2-0a69872a586c

	/// Variação percentual do Faturamento Líquido em relação à semana anterior (WoW, deslocamento de 7 dias).
	measure 'Faturamento Líquido Var % WoW' =
			DIVIDE(
			    [Faturamento Líquido] - [Faturamento Líquido Semana Anterior],
			    [Faturamento Líquido Semana Anterior]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Comparativos Curto Prazo\Semana Anterior
		lineageTag: 8690ae82-0228-434e-9846-2d1c753f9dec

	/// Retorna um código de cor hexadecimal para formatação condicional de visuais por mês (cores alternadas par/impar).
	measure 'Cor Mes' =
			VAR NumeroMes =
			    MONTH(MAX('Calendário'[Dia]))
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISINSCOPE('Calendário'[Mês]) && MOD(NumeroMes, 2) = 0, "#FFF4B3",
			        ISINSCOPE('Calendário'[Mês]) && MOD(NumeroMes, 2) <> 0, "#D9F7D9",
			        "#FFFFFF"
			    )
		isHidden
		lineageTag: 933867ca-5797-44a3-aadb-fe376e7dd091

	/// Título dinâmico geral para o cabeçalho do painel.
	measure Titulo_Painel_Mestre =
			VAR _Grupo = SELECTEDVALUE('Menu Grupo'[Grupo Macro], "Geral")
			VAR _Metrica = SELECTEDVALUE('Menu Métrica'[Métrica Fatiador], "Indicadores")
			RETURN
			    UPPER("Análise de " & _Grupo & " - " & _Metrica)
		formatString: General
		displayFolder: Menu Cascata Inteligente
		lineageTag: 2749317c-5f49-4f80-be08-b1d2986a586f

	/// Medida com escala logarítmica baseada no Realizado para suavizar a proporção visual das barras de dados.
	measure Desempenho_Grafico = IF([Realizado] > 0, LOG([Realizado]), 0)
		formatString: 0.00
		displayFolder: Menu Cascata Inteligente
		lineageTag: 585848bf-5ed7-4c16-aac1-7dd7767e10ce

	/// Métrica de participação percentual da filial sobre o total filtrado na tela.
	measure Participacao_Filial =
			VAR ValorLinha = [Realizado]
			VAR TotalGeralFilial = CALCULATE([Realizado], ALLSELECTED('Lojas'[Filial]))
			RETURN
			    DIVIDE(ValorLinha, TotalGeralFilial)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Menu Cascata Inteligente
		lineageTag: 7059963c-9053-4482-950a-a8be9189f1ac

	/// Métrica de participação percentual do fornecedor sobre o total filtrado na tela.
	measure Participacao_Fornecedor =
			VAR ValorLinha = [Realizado]
			VAR TotalGeralForn = CALCULATE([Realizado], ALLSELECTED('Produto'[Fornecedor Master]))
			RETURN
			    DIVIDE(ValorLinha, TotalGeralForn)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Menu Cascata Inteligente
		lineageTag: 76870e14-2ec1-4039-a007-7694f20ce685

	/// Calcula a variação percentual da Margem Comercial Ajustada do período atual em relação ao Ano Anterior.
	measure 'Var % MGC%' = DIVIDE([MG (%) Ajustado], [MG (%) Ano-1 Ajustado]) - 1
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Margem Comercial\Variações
		lineageTag: 4690887f-e6c8-4ffc-a1ae-2336931e24f0

	/// Calcula a variação percentual da Margem de Contribuição Ajustada do período atual em relação ao Ano Anterior.
	measure 'Var % MG Contribuicao%' = DIVIDE([MG(%) contr. Ajustada], [MG(%) Ano-1 contr. Ajustada]) - 1
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Vendas Diárias\Margem de Contribuição\Variações
		lineageTag: d104fae1-f0a2-497b-a5bd-7d41f681a474

	/// Medida pura de Realizado duplicada para uso exclusivo em Barras de Dados sem distorção logarítmica.
	measure Realizado_Barra =
			/* Medida criada exclusivamente para renderização de Barras de Dados */
			VAR _GrupoSelecao = SELECTEDVALUE('Menu Grupo'[Grupo Macro])
			VAR _MetricaSelecao = SELECTEDVALUE('Menu Métrica'[Métrica Fatiador], "Valor")
			
			RETURN
			    SWITCH(TRUE(),
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Valor", [Faturamento Líquido],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Quantidade", [Quantidade Líquida Vendida],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Tonelagem", [Tonelagem Líquida Vendida],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem Comercial (Valor)", [Margem Comercial],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem Comercial (%)", [MG (%) Ajustado],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem de Contribuição (Valor)", [Margem Contribuição],
			        _GrupoSelecao = "Venda" && _MetricaSelecao = "Margem de Contribuição (%)", [MG(%) contr. Ajustada],
			        _GrupoSelecao = "Acordos" && _MetricaSelecao = "Valor", [Valor Verba],
			        _GrupoSelecao = "Ticket" && _MetricaSelecao = "Quantidade", [Qtd Tickets Hora Filial],
			        _GrupoSelecao = "Ticket" && _MetricaSelecao = "Penetração", [Part % Tickets Hora Filial],
			        _GrupoSelecao = "Cliente" && _MetricaSelecao = "Quantidade", [Qtd Clientes Hora Filial],
			        _GrupoSelecao = "Cliente" && _MetricaSelecao = "Penetração", [Part % Clientes Hora Filial],
			        _GrupoSelecao = "Compra" && _MetricaSelecao = "Valor", [Valor Agenda de Compra],
			        _GrupoSelecao = "Compra" && _MetricaSelecao = "Quantidade", [Qtd Agenda de Compra],
			        _GrupoSelecao = "Compra" && _MetricaSelecao = "Tonelagem", [Tonelagem Agenda de Compra],
			        _GrupoSelecao = "Perda" && _MetricaSelecao = "Valor", [Valor Total Perda],
			        _GrupoSelecao = "Perda" && _MetricaSelecao = "Quantidade", [Quantidade Perda],
			        BLANK()
			    )
		displayFolder: Menu Cascata Inteligente
		lineageTag: 1bf926fc-ef66-46a1-b13c-edaaa9a34b41

		formatStringDefinition = ```
				VAR _M = SELECTEDVALUE('Menu Métrica'[Métrica Fatiador]) 
				RETURN 
				    SWITCH(
				        TRUE(),
				        _M = "Penetração" || CONTAINSSTRING(_M, "%"), "0.0%",
				        _M = "Quantidade" || _M = "Tickets" || _M = "Clientes", "#,##0",
				        _M = "Tonelagem", "#,##0.00",
				        "R$ #,##0.00" -- Padrão para Valor ou qualquer outra métrica monetária
				    )
				```

	/// Medida dinâmica para formatação condicional de cores (Vermelho se < 0, Verde se >= 0).
	measure Cor_Condicional_Dax =
			VAR _Valor = [Var %]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(_Valor), "#000000",
			    _Valor < 0, "#FF0000",   -- Vermelho para negativos
			    _Valor >= 0, "#008000",  -- Verde para positivos
			    "#000000"
			)
		formatString: @
		isHidden
		lineageTag: e66694c2-1eff-4eb7-93f9-5c49f5c4fc34

	column Dummy
		isHidden
		formatString: 0
		isAvailableInMdx: false
		lineageTag: ceed2a8e-270a-4efd-ab3d-a4dafffe76d9
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Dummy]

		annotation SummarizationSetBy = Automatic

	partition Medidas = calculated
		mode: import
		source = ROW("Dummy", BLANK())

	annotation PBI_Id = ececf2b2e77b44ffa94eff7960790f87

