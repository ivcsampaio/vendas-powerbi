          {
            "name": "Venda Média Dia",
            "description": "Média diária de Faturamento Líquido considerando os dias decorridos até ontem no mês.",
            "expression": [
              "VAR _DiasDecorridos = ",
              "    CALCULATE(",
              "        COUNTROWS('Calendário'),",
              "        KEEPFILTERS('Calendário'[Flag Data Passada] = 1),",
              "        ALLEXCEPT('Calendário', 'Calendário'[COD_MES])",
              "    )",
              "",
              "RETURN",
              "    DIVIDE(",
              "        [Faturamento Líquido],",
              "        _DiasDecorridos",
              "    )"
            ],
            "formatString": "R$ #,##0;(R$ #,##0); -",
            "displayFolder": "Vendas Diárias\\Faturamento",
            "lineageTag": "32108e98-ac9e-4421-9a19-50bf2c42c17e"
          },
          {
            "name": "Venda Média Dia Ano Anterior",
            "description": "Venda Média Dia para o mesmo período do ano anterior, limitada estritamente até o dia de hoje.",
            "expression": [
              "IF(",
              "    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,",
              "    CALCULATE(",
              "        [Venda Média Dia],",
              "        SAMEPERIODLASTYEAR('Calendário'[Dia])",
              "    )",
              ")"
            ],
            "formatString": "R$ #,##0;(R$ #,##0); -",
            "displayFolder": "Vendas Diárias\\Faturamento\\Ano Anterior",
            "lineageTag": "18671c13-909c-4b75-89dc-9e5d8ea5b7ea"
          },
          {
            "name": "Custo Líquido com Ajuste Ano Anterior",
            "description": "Soma do Custo Líquido do mesmo período do ano anterior com os Ajustes Gerenciais do PDV do ano anterior (ex: Estoque Negativo, Verba Custo Mês Anterior, Diferença Custo CD, Acordo Comercial, etc.).",
            "expression": [
              "IF(",
              "    CALCULATE(MAX('Calendário'[Flag Data Passada])) = 1,",
              "    CALCULATE(",
              "        [Custo Líquido com Ajuste],",
              "        SAMEPERIODLASTYEAR('Calendário'[Dia])",
              "    )",
              ")"
            ],
            "formatString": "R$ #,##0;(R$ #,##0); -",
            "displayFolder": "Vendas Diárias\\Custos\\Ano Anterior",
            "lineageTag": "796cb2a4-cae6-43bc-b1e5-cc54ecb000e4"
          },
